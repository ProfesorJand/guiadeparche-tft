---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import { crearJSONSchema } from "@json/schema/crearJSONSchema";
import BlogFilter from "@components/blog/BlogFilter.jsx";
import BlogGrid from "@components/blog/BlogGrid.jsx";
import { getSortedBlogPosts } from "@data/blogData";

const initialPosts = await getSortedBlogPosts();

const title = "Blog de Guía de Parche - Noticias, Novedades y Teamfight Tactics";
const description = "Descubre las últimas noticias, análisis de parches, guías competitivas de Teamfight Tactics y todas las novedades de Jupeson y la comunidad de Guía de Parche.";
const keywords = "Blog TFT, Noticias Teamfight Tactics, Novedades TFT, Jupeson, Guia de Parche, Parches TFT, Meta Comps, Esports TFT";
const canonical = new URL(Astro.url.pathname, Astro.site || "https://guiadeparche.com").href;

const thumbnail = initialPosts[0]?.image || "/blog/blog_tft_cover.jpg";
const imgPost = initialPosts[0]?.image || "/blog/blog_tft_cover.jpg";
const JSONSchema = crearJSONSchema({ title, description, thumbnail, imgPost });
---

<LayoutMaxWidth
  title={title}
  description={description}
  keywords={keywords}
  JSONSchema={JSONSchema}
  canonical={canonical}
  image={imgPost}
>
  <div class="blogPageContainer">
    <!-- Encabezado Hero de la página de Blog -->
    <header class="blogHero">
      <div class="heroBadge">
        <span class="badgeDot"></span>
        Actualizaciones & Artículos
      </div>
      <h1 class="heroTitle">
        Blog & <span class="heroGradientText">Novedades</span>
      </h1>
      <p class="heroSubtitle">
        Mantente al día con las noticias más recientes del competitivo de Teamfight Tactics,
        estrategias avanzadas, análisis de metajuego y novedades exclusivas de la mano de Jupeson.
      </p>
    </header>

    <!-- Barra de Filtros y Búsqueda -->
    <section class="filterSection">
      <BlogFilter client:load />
    </section>

    <!-- Grilla de Tarjetas de Noticias ordenadas por fecha -->
    <section class="gridSection">
      <BlogGrid client:load initialPosts={initialPosts} />
    </section>
  </div>
</LayoutMaxWidth>

<style>
  .blogPageContainer {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .blogHero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }

  .heroBadge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(192, 132, 252, 0.3);
    color: #c084fc;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
    backdrop-filter: blur(8px);
  }

  .badgeDot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #a855f7;
    box-shadow: 0 0 8px #c084fc;
  }

  .heroTitle {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .heroGradientText {
    background: linear-gradient(135deg, #c084fc 0%, #e879f9 50%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .heroSubtitle {
    max-width: 680px;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 auto;
  }

  .filterSection {
    width: 100%;
    position: relative;
  }

  .gridSection {
    width: 100%;
  }

  /* Regla 8: Media query para dispositivos móviles */
  @media only screen and (max-width: 900px) {
    .blogPageContainer {
      padding: 1.25rem 1rem 3rem;
    }

    .heroTitle {
      font-size: 2.2rem;
    }

    .heroSubtitle {
      font-size: 0.95rem;
    }

    .blogHero {
      margin-bottom: 2rem;
    }
  }
</style>

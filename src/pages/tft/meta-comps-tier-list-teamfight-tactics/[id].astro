---
import MetaCompsLayout from "@components/TFT/MetaCompsLayout.astro";
import {
  getComposFromDB,
  getConstantes,
  getLastUpdateDate,
  getMetaEntidades,
  getSetDataForBuild,
} from "@lib/cache/tftCache.js";
import {
  setNumberPBE,
  setNumberLatest,
  dataTFTChampions,
  loadDataTFTFromAPI,
  versionTFT,
  EXCLUDED_API_NAMES,
} from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import {
  slugifyTftEntity,
  isPlayableTftItem,
  safeJsonParse,
} from "@utils/tftEntitySlug.js";

import PaginaCampeon from "@components/TFT/meta/PaginaCampeon.astro";
import PaginaSinergia from "@components/TFT/meta/PaginaSinergia.astro";
import PaginaItem from "@components/TFT/meta/PaginaItem.astro";

export async function getStaticPaths() {
  // Orden ascendente de sets configurados: el último siempre es el set más nuevo y prevalece en URLs repetidas
  const CONFIGURED_SETS = Array.from(
    new Set([String(setNumberLatest), String(setNumberPBE)])
  )
    .filter((s) => s && !Number.isNaN(Number(s)))
    .sort((a, b) => Number(a) - Number(b));

  const excludedSet = new Set((EXCLUDED_API_NAMES || []).map((a) => String(a).toLowerCase()));

  // 1. Cargar composiciones, catálogos por set y metadatos SEO de la BD en paralelo
  const [todasLasComps, campeonesMetaDB, ...setBundles] = await Promise.all([
    getComposFromDB(),
    getMetaEntidades("campeones_tft"),
    ...CONFIGURED_SETS.map(async (setNum) => {
      const [setData, traitsMetaDB, itemsMetaDB] = await Promise.all([
        getSetDataForBuild(setNum),
        getMetaEntidades(`traits_TFT_set_${setNum}`),
        getMetaEntidades(`items_tft_set_${setNum}`),
      ]);
      return { setNum, setData, traitsMetaDB, itemsMetaDB };
    }),
  ]);

  const setDataBySet = {};
  setBundles.forEach(({ setNum, setData }) => {
    setDataBySet[setNum] = setData;
  });

  // Helper para indexar metadatos SEO de BD por apiName (en minúsculas) y por set
  const safeCampeonesMetaDB = Array.isArray(campeonesMetaDB) ? campeonesMetaDB : [];
  const champMetaByKey = new Map();
  safeCampeonesMetaDB.forEach((row) => {
    if (!row?.apiName) return;
    const setKey = String(row.tft_set || row.set_number || "");
    champMetaByKey.set(`${setKey}::${row.apiName.toLowerCase()}`, row);
    if (!champMetaByKey.has(`any::${row.apiName.toLowerCase()}`)) {
      champMetaByKey.set(`any::${row.apiName.toLowerCase()}`, row);
    }
  });

  // Helper para fusionar un registro del catálogo del set con su fila SEO del MISMO set en BD
  const mergeSameSetMeta = (baseEntity, metaRow, setNum) => {
    if (!metaRow) {
      return { ...baseEntity, tft_set: String(baseEntity.tft_set || setNum) };
    }
    return {
      ...baseEntity,
      ...metaRow,
      // Preservar campos estructurales del set si en BD vinieran vacíos
      name: metaRow.name || baseEntity.name,
      apiName: baseEntity.apiName || metaRow.apiName,
      icon: baseEntity.icon || metaRow.icon,
      tileIcon: baseEntity.tileIcon || metaRow.tileIcon,
      squareIcon: baseEntity.squareIcon || metaRow.squareIcon,
      traits: baseEntity.traits?.length ? baseEntity.traits : metaRow.traits,
      effects: baseEntity.effects?.length ? baseEntity.effects : metaRow.effects,
      composition: baseEntity.composition?.length ? baseEntity.composition : metaRow.composition,
      desc: baseEntity.desc || metaRow.desc,
      ability: baseEntity.ability || metaRow.ability,
      ability_variables: baseEntity.ability_variables || metaRow.ability_variables,
      tft_set: String(setNum),
    };
  };

  // =========================================================================
  // 2. Construir mapas deduplicados por slug (siempre gana el set más nuevo)
  // =========================================================================
  const campeonesBySlug = new Map();
  const sinergiasBySlug = new Map();
  const itemsBySlug = new Map();

  // Mapas por set para enlaces internos (campeón -> sinergias / ítems, ítem -> componentes)
  const slugMapsBySet = {};

  // Registrar apiNames históricos de campeones en BD (ej. Set 17) para historial de comps
  const historicalChampApisBySlug = new Map();
  safeCampeonesMetaDB.forEach((row) => {
    const slug = (row.url_seo ? String(row.url_seo).trim().toLowerCase() : slugifyTftEntity(row.name));
    if (!slug || !row.apiName) return;
    if (!historicalChampApisBySlug.has(slug)) {
      historicalChampApisBySlug.set(slug, new Set());
    }
    historicalChampApisBySlug.get(slug).add(row.apiName);
  });

  // Recorrer sets en orden ascendente (18 -> 19 -> ...) para que el set más nuevo sobreescriba `data`
  for (const { setNum, setData, traitsMetaDB, itemsMetaDB } of setBundles) {
    slugMapsBySet[setNum] = {
      champByApi: {},
      traitByApi: {},
      itemByApi: {},
    };

    const safeTraitsMetaDB = Array.isArray(traitsMetaDB) ? traitsMetaDB : [];
    const safeItemsMetaDB = Array.isArray(itemsMetaDB) ? itemsMetaDB : [];

    const traitMetaMap = new Map();
    safeTraitsMetaDB.forEach((t) => {
      if (t?.apiName) traitMetaMap.set(t.apiName.toLowerCase(), t);
    });

    const itemMetaMap = new Map();
    safeItemsMetaDB.forEach((i) => {
      if (i?.apiName) itemMetaMap.set(i.apiName.toLowerCase(), i);
    });

    // --- A. CAMPEONES DEL SET ---
    const validChamps = (setData.champions || []).filter((c) => {
      if (!c || !c.apiName || !c.name) return false;
      const apiLow = c.apiName.toLowerCase();
      if (excludedSet.has(apiLow)) return false;
      const parsedTraits = safeJsonParse(c.traits, c.traits) || [];
      const hasTraits = Array.isArray(parsedTraits) && parsedTraits.length > 0;
      const validCost = Number(c.cost) >= 1 && Number(c.cost) <= 7;
      // Permitir campeones jugables (o especiales con coste 0 que tengan rasgos y habilidad, como Aatrox/Cho'Gath)
      return hasTraits || (validCost && Boolean(c.tileIcon || c.squareIcon || c.icon));
    });

    validChamps.forEach((champ) => {
      const apiLow = champ.apiName.toLowerCase();
      const dbRow = champMetaByKey.get(`${setNum}::${apiLow}`) || null;
      const merged = mergeSameSetMeta(champ, dbRow, setNum);
      const slug = dbRow?.url_seo
        ? String(dbRow.url_seo).trim().toLowerCase()
        : slugifyTftEntity(merged.name);
      if (!slug) return;

      slugMapsBySet[setNum].champByApi[apiLow] = slug;

      const existing = campeonesBySlug.get(slug);
      const matchingApiNames = new Set(existing?.matchingApiNames || []);
      matchingApiNames.add(merged.apiName);
      // Incorporar apiNames históricos que compartan el mismo slug
      const histApis = historicalChampApisBySlug.get(slug);
      if (histApis) {
        histApis.forEach((a) => matchingApiNames.add(a));
      }

      campeonesBySlug.set(slug, {
        slug,
        data: merged,
        entitySetNumber: setNum,
        matchingApiNames: Array.from(matchingApiNames),
      });
    });

    // --- B. SINERGIAS (TRAITS) DEL SET ---
    const validTraits = (setData.traits || []).filter((t) => {
      if (!t || !t.apiName || !t.name) return false;
      const dbRow = traitMetaMap.get(t.apiName.toLowerCase());
      if (dbRow?.url_seo) return true;
      const effects = safeJsonParse(t.effects, t.effects) || [];
      return Boolean(t.icon) && Array.isArray(effects) && effects.length > 0;
    });

    validTraits.forEach((trait) => {
      const apiLow = trait.apiName.toLowerCase();
      const dbRow = traitMetaMap.get(apiLow) || null;
      const merged = mergeSameSetMeta(trait, dbRow, setNum);
      const slug = dbRow?.url_seo
        ? String(dbRow.url_seo).trim().toLowerCase()
        : slugifyTftEntity(merged.name);
      if (!slug) return;

      slugMapsBySet[setNum].traitByApi[apiLow] = slug;

      const existing = sinergiasBySlug.get(slug);
      const matchingApiNamesBySet = { ...(existing?.matchingApiNamesBySet || {}) };
      const setList = new Set(matchingApiNamesBySet[setNum] || []);
      setList.add(merged.apiName);
      matchingApiNamesBySet[setNum] = Array.from(setList);

      sinergiasBySlug.set(slug, {
        slug,
        data: merged,
        entitySetNumber: setNum,
        matchingApiNamesBySet,
      });
    });

    // --- C. ÍTEMS DEL SET ---
    // Puntuar cada ítem para elegir el registro más rico cuando conviven alias del mismo ítem (ej. DA_HandOfJustice y TFT_Item_UnstableConcoction)
    const scoreItemRichness = (it) => {
      let score = 0;
      if (it.url_seo) score += 100;
      if (it.desc_item && String(it.desc_item).trim().length > 0) score += 50;
      if (it.desc && String(it.desc).trim().length > 0) score += 40;
      const eff = safeJsonParse(it.effects, it.effects);
      if (eff && typeof eff === "object") score += Math.min(Object.keys(eff).length * 3, 30);
      if (Array.isArray(it.composition) && it.composition.length === 2) score += 10;
      if (/^TFT\d*_Item_/i.test(it.apiName || "")) score += 5;
      return score;
    };

    const validItems = (setData.items || [])
      .map((item) => {
        const dbRow = itemMetaMap.get((item?.apiName || "").toLowerCase()) || null;
        return mergeSameSetMeta(item, dbRow, setNum);
      })
      .filter((item) => isPlayableTftItem(item));

    // Agrupar alias dentro del mismo set por slug para conservar todos sus apiNames y elegir el registro más completo
    const itemsGroupedThisSet = new Map();
    validItems.forEach((item) => {
      const apiLow = item.apiName.toLowerCase();
      let slug = item.url_seo
        ? String(item.url_seo).trim().toLowerCase()
        : slugifyTftEntity(item.name);
      if (!slug) return;

      const isRadiant = /radiant/i.test(item.apiName);
      if (isRadiant && !slug.includes("radiante") && !slug.includes("radiant")) {
        // Evitar que un ítem radiante sin sufijo en el nombre pise al ítem normal
        const currentGroup = itemsGroupedThisSet.get(slug);
        if (currentGroup && !/radiant/i.test(currentGroup.bestItem.apiName)) {
          slug = `${slug}-radiante`;
        }
      }

      slugMapsBySet[setNum].itemByApi[apiLow] = slug;

      const group = itemsGroupedThisSet.get(slug);
      if (!group) {
        itemsGroupedThisSet.set(slug, {
          bestItem: item,
          bestScore: scoreItemRichness(item),
          apiNames: new Set([item.apiName]),
        });
      } else {
        group.apiNames.add(item.apiName);
        const candidateScore = scoreItemRichness(item);
        if (candidateScore > group.bestScore) {
          group.bestItem = item;
          group.bestScore = candidateScore;
        }
      }
    });

    for (const [slug, group] of itemsGroupedThisSet.entries()) {
      const existing = itemsBySlug.get(slug);
      const matchingApiNames = new Set(existing?.matchingApiNames || []);
      group.apiNames.forEach((api) => matchingApiNames.add(api));

      // Preservar el ítem del set más reciente como `data`, heredando `desc_item`/`desc` solo si el set más nuevo viniera completamente vacío?
      // No: siempre mostrar estrictamente la data oficial del set más reciente.
      itemsBySlug.set(slug, {
        slug,
        data: group.bestItem,
        entitySetNumber: setNum,
        matchingApiNames: Array.from(matchingApiNames),
      });
    }
  }

  // =========================================================================
  // 3. Evitar cualquier colisión de rutas entre Campeón, Sinergia, Ítem y Compo
  //    Prioridad de URL limpia: Campeón > Sinergia > Ítem > Composición
  // =========================================================================
  const claimedSlugs = new Set();
  const paths = [];

  // Campeones
  for (const entry of campeonesBySlug.values()) {
    const finalSlug = entry.slug;
    if (claimedSlugs.has(finalSlug)) continue;
    claimedSlugs.add(finalSlug);

    const setInfo = setDataBySet[entry.entitySetNumber] || { champions: [], traits: [], items: [] };
    const setSlugs = slugMapsBySet[entry.entitySetNumber] || { traitByApi: {}, itemByApi: {} };

    paths.push({
      params: { id: finalSlug },
      props: {
        type: "campeon",
        data: entry.data,
        entitySetNumber: entry.entitySetNumber,
        matchingApiNames: entry.matchingApiNames,
        allComps: todasLasComps,
        setTraits: setInfo.traits,
        setItems: setInfo.items,
        traitSlugByApi: setSlugs.traitByApi,
        itemSlugByApi: setSlugs.itemByApi,
      },
    });
  }

  // Sinergias
  for (const entry of sinergiasBySlug.values()) {
    let finalSlug = entry.slug;
    if (claimedSlugs.has(finalSlug)) {
      finalSlug = `${entry.slug}-sinergia`;
      // Actualizar mapa de enlaces del set para que los campeones apunten a la URL final
      Object.values(slugMapsBySet).forEach((m) => {
        Object.keys(m.traitByApi).forEach((k) => {
          if (m.traitByApi[k] === entry.slug) m.traitByApi[k] = finalSlug;
        });
      });
    }
    if (claimedSlugs.has(finalSlug)) continue;
    claimedSlugs.add(finalSlug);

    const setInfo = setDataBySet[entry.entitySetNumber] || { champions: [], traits: [], items: [] };
    const setSlugs = slugMapsBySet[entry.entitySetNumber] || { champByApi: {} };

    paths.push({
      params: { id: finalSlug },
      props: {
        type: "sinergia",
        data: entry.data,
        entitySetNumber: entry.entitySetNumber,
        matchingApiNamesBySet: entry.matchingApiNamesBySet,
        setDataBySet,
        allComps: todasLasComps,
        allChampions: setInfo.champions,
        allTraits: setInfo.traits,
        champSlugByApi: setSlugs.champByApi,
      },
    });
  }

  // Ítems
  for (const entry of itemsBySlug.values()) {
    let finalSlug = entry.slug;
    if (claimedSlugs.has(finalSlug)) {
      finalSlug = `${entry.slug}-item`;
      Object.values(slugMapsBySet).forEach((m) => {
        Object.keys(m.itemByApi).forEach((k) => {
          if (m.itemByApi[k] === entry.slug) m.itemByApi[k] = finalSlug;
        });
      });
    }
    if (claimedSlugs.has(finalSlug)) continue;
    claimedSlugs.add(finalSlug);

    const setInfo = setDataBySet[entry.entitySetNumber] || { champions: [], traits: [], items: [] };
    const setSlugs = slugMapsBySet[entry.entitySetNumber] || { itemByApi: {} };

    paths.push({
      params: { id: finalSlug },
      props: {
        type: "item",
        data: entry.data,
        entitySetNumber: entry.entitySetNumber,
        matchingApiNames: entry.matchingApiNames,
        allComps: todasLasComps,
        setItems: setInfo.items,
        itemSlugByApi: setSlugs.itemByApi,
      },
    });
  }

  // Composiciones (agrupadas por urlSEO, gana el set_number mayor, sin pisar entidades)
  const compsUnicasPorUrl = {};
  (todasLasComps || []).forEach((comp) => {
    if (comp.urlSEO && String(comp.urlSEO).trim() !== "") {
      const url = String(comp.urlSEO).trim().toLowerCase();
      const currentSet = Number(comp.set_number) || 0;
      if (!compsUnicasPorUrl[url] || currentSet > (Number(compsUnicasPorUrl[url].set_number) || 0)) {
        compsUnicasPorUrl[url] = comp;
      }
    }
  });

  Object.values(compsUnicasPorUrl).forEach((comp) => {
    const url = String(comp.urlSEO).trim().toLowerCase();
    if (!url || claimedSlugs.has(url)) return;
    claimedSlugs.add(url);
    paths.push({
      params: { id: url },
      props: {
        type: "compo",
        data: comp,
        entitySetNumber: String(comp.set_number || setNumberLatest),
        allComps: todasLasComps,
      },
    });
  });

  console.log(
    `=== RUTAS TFT GENERADAS: ${paths.length} total (Sets: ${CONFIGURED_SETS.join(", ")}) ===`
  );

  return paths;
}

const { id } = Astro.params;
const {
  type,
  data,
  entitySetNumber,
  matchingApiNames = [],
  matchingApiNamesBySet = {},
  setDataBySet = {},
  allComps = [],
  allChampions = [],
  allTraits = [],
  setTraits = [],
  setItems = [],
  traitSlugByApi = {},
  itemSlugByApi = {},
  champSlugByApi = {},
} = Astro.props;

const comp = type === "compo" ? data : null;

const [numberOfPatch, lastUpdateComps] = await Promise.all([
  getConstantes(),
  getLastUpdateDate("composiciones_tft"),
]);

const resolvedSetNumber = String(
  entitySetNumber || comp?.set_number || data?.set_number || data?.tft_set || setNumberPBE
);
const targetVersion = resolvedSetNumber === String(setNumberPBE) ? "pbe" : "latest";

// Para páginas de composición individual, asegurar que el store global esté alineado con su set
if (type === "compo") {
  if (versionTFT.get() !== targetVersion) {
    versionTFT.set(targetVersion);
    await loadDataTFTFromAPI({ version: targetVersion });
  } else if (dataTFTChampions.get().length === 0) {
    await loadDataTFTFromAPI({ version: targetVersion });
  }
}

const championsStore = dataTFTChampions.get() || [];
const targetApiName = comp?.campeonMeta?.apiNameCampeon || data?.apiName;
const champInfo =
  type === "campeon"
    ? data
    : championsStore.find((c) => c.apiName === targetApiName);

const resolvedTileIcon =
  champInfo?.tileIcon || data?.tileIcon
    ? getLocalTftImage(
        champInfo?.tileIcon || data?.tileIcon,
        "champions/tileIcon",
        resolvedSetNumber
      )
    : "";
---

{type === "compo" && comp && (
  <MetaCompsLayout
    titleMain={`${comp.urlSEO.toUpperCase().replace(/-/g, " ")} TFT Comp & Items Build - Set ${comp.set_number || resolvedSetNumber}`}
    titleHighlight={``}
    description={
      comp.tipSEO ||
      `Guía completa paso a paso de la composición ${comp.titulo} para el parche actual de TFT.`
    }
    lastUpdate={`${lastUpdateComps} Parche ${
      String(comp?.set_number) === String(setNumberPBE)
        ? numberOfPatch.MetaCompVersionPBE
        : numberOfPatch.MetaCompVersion
    }`}
    allComps={allComps}
    comp={comp}
    activeId={id}
    snippetImgUrl={resolvedTileIcon}
    isIndividual={true}
  />
)}

{type === "campeon" && data && (
  <PaginaCampeon
    data={data}
    entitySetNumber={resolvedSetNumber}
    matchingApiNames={matchingApiNames}
    allComps={allComps}
    setTraits={setTraits}
    setItems={setItems}
    traitSlugByApi={traitSlugByApi}
    itemSlugByApi={itemSlugByApi}
    resolvedTileIcon={resolvedTileIcon}
    lastUpdate={lastUpdateComps}
    version={numberOfPatch}
  />
)}

{type === "sinergia" && data && (
  <PaginaSinergia
    data={data}
    entitySetNumber={resolvedSetNumber}
    matchingApiNamesBySet={matchingApiNamesBySet}
    setDataBySet={setDataBySet}
    allComps={allComps}
    lastUpdate={lastUpdateComps}
    version={numberOfPatch}
    allChampions={allChampions}
    allTraits={allTraits}
    champSlugByApi={champSlugByApi}
  />
)}

{type === "item" && data && (
  <PaginaItem
    data={data}
    entitySetNumber={resolvedSetNumber}
    matchingApiNames={matchingApiNames}
    allComps={allComps}
    setItems={setItems}
    itemSlugByApi={itemSlugByApi}
    lastUpdate={lastUpdateComps}
    version={numberOfPatch}
  />
)}

---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import { crearJSONSchema } from "@json/schema/crearJSONSchema";

import PaginaBaseMaxWidth from "@components/TFT/paginas/PaginaBaseMaxWidth.astro";
import MasterPlanPage from "@components/TFT/master-plan/MasterPlanPage";
import MasterPlanContent from "@components/TFT/master-plan/MasterPlanContent.jsx";

const topTitle="TFT Master Plan";
const lowerTitle="";
const title=`${topTitle}`;
const description="TFT Master Plan es una herramienta para mejorar en TFT y tomar mejores decisiones durante tus partidas. Combina análisis del meta, composiciones de TFT y conocimiento de coaching TFT para ayudarte a saber qué jugar, cuándo jugarlo y cómo adaptar tu estrategia sin tener que analizar cientos de composiciones por tu cuenta. Jupeson te explica más a detalle en el siguiente video:";
const keywords="tft, master plan, teamfight tactics, guiadeparche, masterplan, guia tft";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const baseSchema = JSON.parse(
  crearJSONSchema({title, description: description})
);
const JSONSchema = JSON.stringify(baseSchema);

// TODO: Cambia esta variable por tu lógica real de autenticación/suscripción
//const hasMasterPlanActive = true; 
---
<LayoutMaxWidth 
  title={title}
  description={description}
  keywords={keywords}
  JSONSchema={JSONSchema}
  canonical={canonicalURL}
  >
    <PaginaBaseMaxWidth
      topTitle={topTitle}
      textInfo={[
        description
      ]}
    >
      <div slot="bodyContainerLeft">
        <!-- Columna izquierda vacía para consistencia -->
      </div>

      <div slot="bodyContainerMid" class="bodyContainerMid">
        <MasterPlanContent client:only="react" />
      </div>

      <div slot="bodyContainerRight">
        <!-- Columna Derecha vacía para consistencia -->
      </div>
    </PaginaBaseMaxWidth>
</LayoutMaxWidth>

<style>
  a{
    color: var(--text-color-white-primary);
    text-decoration: none;
    background: var(--bg-purple-secondary);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    transition: all 0.3s ease;
    width: fit-content;
  }
  a:hover{
    background: var(--bg-purple-primary);
    text-decoration: none;
  }

</style>
---
// src/pages/publicidad/overlay.astro
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OBS Overlay Publicidad</title>
    <style is:global>
        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: transparent !important; /* Esencial para OBS */
            position: relative;
        }

        #ad-container {
            position: absolute;
            bottom: 50px;
            left: 50px;
            width: 300px;
            height: 300px;
            /* Usar visibility en lugar de display para que la transición de opacity funcione fluido */
            visibility: hidden;
            opacity: 0;
            overflow: hidden;
            transition: opacity 1s ease-in-out, visibility 1s ease-in-out;
            /* Se eliminó flexbox para evitar bugs de tamaño intrínseco del video */
        }

        #ad-container.show {
            visibility: visible;
            opacity: 1;
        }

        #ad-media {
            /* Forzar límites estrictos al video/imagen basados en el padre */
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
            min-width: 0 !important;
            min-height: 0 !important;
            object-fit: contain;
            display: block;
        }
    </style>
</head>
<body>

    <div id="ad-container">
        <!-- El contenido multimedia se inyectará aquí -->
    </div>

    <script>
        const API_URL = 'https://api.guiadeparche.com/publicidad/publicidad_api.php';
        const TRACK_URL = 'https://api.guiadeparche.com/publicidad/track_ad_impression.php';
        
        const urlParams = new URLSearchParams(window.location.search);
        const alias = urlParams.get('alias');
        const campaignId = urlParams.get('camp');
        const isTest = urlParams.get('test') === '1';

        // Custom Positioning & Sizing from URL
        const customW = urlParams.get('w');
        const customH = urlParams.get('h');
        const customT = urlParams.get('t');
        const customB = urlParams.get('b');
        const customL = urlParams.get('l');
        const customR = urlParams.get('r');

        const container = document.getElementById('ad-container');
        if (customW) container.style.width = customW + 'px';
        if (customH) container.style.height = customH + 'px';
        
        if (customT) {
            container.style.top = customT + 'px';
            container.style.bottom = 'auto'; // overrides default bottom
        } else if (customB) {
            container.style.bottom = customB + 'px';
            container.style.top = 'auto';
        }
        
        if (customR) {
            container.style.right = customR + 'px';
            container.style.left = 'auto'; // overrides default left
        } else if (customL) {
            container.style.left = customL + 'px';
            container.style.right = 'auto';
        }

        let intervalMinutes = 15;
        let mediaUrl = '';
        let isVideo = false;

        async function fetchCampaignDetails() {
            if (!alias || !campaignId) {
                console.error("Faltan parámetros en la URL (alias o camp)");
                return;
            }

            try {
                // Para obtener la campaña, usaremos el endpoint existente pero filtramos en el cliente (lo ideal sería un endpoint GET /campaigns?id=X)
                const res = await fetch(`${API_URL}?action=campaigns`);
                const data = await res.json();
                
                if (data.status === 'success') {
                    const campaign = data.data.find(c => c.id == campaignId);
                    if (campaign && campaign.is_active) {
                        intervalMinutes = campaign.interval_minutes;
                        mediaUrl = campaign.media_url;
                        isVideo = mediaUrl.match(/\.(mp4|webm|ogg)$/i) !== null;
                        
                        setupAdContainer();
                        startAdCycle();
                    } else {
                        console.error("Campaña inactiva o no encontrada");
                    }
                }
            } catch (error) {
                console.error("Error obteniendo campaña", error);
            }
        }

        function setupAdContainer() {
            const container = document.getElementById('ad-container');
            container.innerHTML = ''; // Limpiar

            if (isVideo) {
                const video = document.createElement('video');
                video.id = 'ad-media';
                video.src = mediaUrl;
                video.muted = false; // OBS suele mutear por defecto si el usuario no interactúa, revisar config OBS
                
                // Forzar estilos por JS para ser a prueba de balas (ignora cualquier problema de CSS externo)
                video.style.position = 'absolute';
                video.style.top = '0';
                video.style.left = '0';
                video.style.width = '100%';
                video.style.height = '100%';
                video.style.maxWidth = '100%';
                video.style.maxHeight = '100%';
                video.style.objectFit = 'contain';
                video.style.display = 'block';

                video.addEventListener('ended', hideAd);
                container.appendChild(video);
            } else {
                const img = document.createElement('img');
                img.id = 'ad-media';
                img.src = mediaUrl;
                
                // Forzar estilos por JS
                img.style.position = 'absolute';
                img.style.top = '0';
                img.style.left = '0';
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.maxWidth = '100%';
                img.style.maxHeight = '100%';
                img.style.objectFit = 'contain';
                img.style.display = 'block';

                container.appendChild(img);
            }
        }

        function startAdCycle() {
            const storageKey = 'last_ad_time_' + campaignId;
            
            function checkAndShowAd() {
                // TRUCO MAESTRO: Si la escena de OBS no está visible en pantalla (o el ojito está apagado),
                // document.hidden será true. En ese caso abortamos, asegurando que la publicidad
                // NUNCA se reproduzca ni mande mensajes al chat si no se está viendo.
                if (document.hidden) {
                    return; 
                }

                const now = Date.now();
                const lastTime = localStorage.getItem(storageKey);
                const cooldownMs = intervalMinutes * 60 * 1000;
                
                // Si no hay registro, o ya pasó el tiempo de cooldown, mostramos el anuncio
                if (!lastTime || (now - parseInt(lastTime)) >= cooldownMs) {
                    localStorage.setItem(storageKey, now.toString());
                    showAd();
                }
            }

            // Chequeamos al cargar la fuente
            checkAndShowAd();

            // Luego seguimos chequeando cada 10 segundos constantemente
            setInterval(checkAndShowAd, 10000); 
        }

        async function showAd() {
            const container = document.getElementById('ad-container');
            container.classList.add('show');

            if (isVideo) {
                const video = document.getElementById('ad-media');
                video.currentTime = 0;
                video.play().catch(e => console.error("Error reproduciendo video", e));
            } else {
                // tiempo que se mantiene la imagen publicitaria en obs
                setTimeout(hideAd, 10000); // SEGUNDOS DE PUBLICIDAD PARA IMAGENES
            }

            // Registrar impresión y lanzar bot
            try {
                await fetch(TRACK_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ alias: alias, campaign_id: campaignId, is_test: isTest })
                });
            } catch (e) {
                console.error("Error registrando impresión", e);
            }
        }

        function hideAd() {
            const container = document.getElementById('ad-container');
            container.classList.remove('show');
        }

        // Iniciar todo
        fetchCampaignDetails();
    </script>
</body>
</html>

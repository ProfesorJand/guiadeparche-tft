---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import CompsPorSet from "@components/TFT/meta/CompsPorSet.jsx";
import CampeonHeroTooltip from "@components/TFT/meta/CampeonHeroTooltip.jsx";
import Youtube from "@components/youtube/Youtube.jsx";
import { setNumberPBE } from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import { formatChampionDescription } from "@components/tooltips/functions.jsx";
import {
  compUsesChampion,
  groupCompsBySet,
  normalizeItemApiName,
  safeJsonParse,
  slugifyTftEntity,
} from "@utils/tftEntitySlug.js";

const {
  data,
  entitySetNumber,
  matchingApiNames = [],
  allComps = [],
  setTraits = [],
  setItems = [],
  traitSlugByApi = {},
  itemSlugByApi = {},
  resolvedTileIcon,
  lastUpdate,
  version,
} = Astro.props;

const activeSet = String(entitySetNumber || data.tft_set || setNumberPBE);
const apiNamesToMatch = matchingApiNames.length > 0 ? matchingApiNames : [data.apiName];

// Sinergias del campeón en el set más reciente
const parsedTraits = safeJsonParse(data.traits, data.traits) || [];
const traitsList = (Array.isArray(parsedTraits) ? parsedTraits : []).map((traitKey) => {
  const found = (setTraits || []).find(
    (st) =>
      st.name?.toLowerCase() === String(traitKey).toLowerCase() ||
      st.apiName?.toLowerCase() === String(traitKey).toLowerCase()
  );
  if (found) {
    const slug =
      traitSlugByApi[(found.apiName || "").toLowerCase()] ||
      (found.url_seo ? String(found.url_seo).toLowerCase() : slugifyTftEntity(found.name));
    return {
      ...found,
      slug,
      iconSrc: found.icon ? getLocalTftImage(found.icon, "traits", activeSet) : "",
    };
  }
  return { name: String(traitKey), icon: "", iconSrc: "", slug: slugifyTftEntity(traitKey) };
});

// Habilidad del campeón en el set más reciente (para el tooltip al hacer hover sobre la imagen)
const parsedAbility = safeJsonParse(data.ability, { name: "", icon: "", desc: "" }) || {
  name: "",
  icon: "",
  desc: "",
};
const parsedAbilityVars =
  safeJsonParse(data.ability_variables, parsedAbility.variables || []) || [];
const abilityDescFormatted = formatChampionDescription(
  parsedAbility.desc || data.ability_desc || "",
  parsedAbilityVars
);

// Composiciones relacionadas en TODOS los sets donde aparece este campeón
const relatedComps = (allComps || []).filter((comp) =>
  compUsesChampion(comp, apiNamesToMatch)
);
const compsBySet = groupCompsBySet(relatedComps, activeSet);

// Primera composición estrictamente del set actual (`activeSet`); si no hay en este set, no se muestra el párrafo
const currentSetComps = compsBySet.find((g) => g.setNumber === activeSet)?.comps || [];
const firstComp = currentSetComps[0] || null;
const rawTipSeo = firstComp?.tipSEO ? String(firstComp.tipSEO).trim() : "";
const firstCompTipSeoLower = rawTipSeo
  ? rawTipSeo.charAt(0).toLowerCase() + rawTipSeo.slice(1)
  : "";

// Objetos recomendados: priorizar los mismos del catálogo del campeón (/tft/set/19#campeones)
const catalogRecommended = Array.isArray(data.recommendedItems) && data.recommendedItems.length > 0
  ? data.recommendedItems
  : Array.isArray(parsedAbility?.recommendedItems) && parsedAbility.recommendedItems.length > 0
    ? parsedAbility.recommendedItems
    : [];

const bestItems = [];
const seenItemSlugs = new Set();

const pushResolvedItem = (itemEntry) => {
  if (!itemEntry) return;
  const itemRef = typeof itemEntry === "object" ? itemEntry.apiName || itemEntry.name : itemEntry;
  if (!itemRef) return;

  const normRef = normalizeItemApiName(itemRef);
  const found = (setItems || []).find(
    (i) =>
      normalizeItemApiName(i.apiName) === normRef ||
      i.name?.toLowerCase() === String(itemRef).toLowerCase()
  );

  const resolvedObj = found || (typeof itemEntry === "object" ? itemEntry : null);
  if (!resolvedObj || !resolvedObj.name) return;

  const slug =
    itemSlugByApi[(resolvedObj.apiName || "").toLowerCase()] ||
    slugifyTftEntity(resolvedObj.name);
  if (!slug || seenItemSlugs.has(slug)) return;
  seenItemSlugs.add(slug);

  bestItems.push({
    ...resolvedObj,
    slug,
    iconSrc: getLocalTftImage(resolvedObj.icon, "items", activeSet),
  });
};

if (catalogRecommended.length > 0) {
  catalogRecommended.forEach(pushResolvedItem);
} else {
  // Fallback para campeones de sets anteriores sin recommendedItems en el catálogo: extraer de las compos
  const matchSetLower = new Set(apiNamesToMatch.map((a) => String(a).toLowerCase()));
  const sourceComps = currentSetComps.length > 0 ? currentSetComps : relatedComps;
  sourceComps.forEach((comp) => {
    const pos = safeJsonParse(comp.posicionamiento, []);
    if (!Array.isArray(pos)) return;
    pos.forEach((boardVariant) => {
      if (!boardVariant || !Array.isArray(boardVariant.tablero)) return;
      boardVariant.tablero.forEach((cell) => {
        if (!cell) return;
        const cellApi = String(cell.apiNameCampeon || cell.campeon || "").toLowerCase();
        if (matchSetLower.has(cellApi) && Array.isArray(cell.apiNameItemsDelCampeon)) {
          cell.apiNameItemsDelCampeon.forEach(pushResolvedItem);
        }
      });
    });
  });
}

// Secciones Dinámicas
const parsedSecciones = safeJsonParse(data.secciones, []) || [];

const traitsNamesText = traitsList.map((t) => t.name).join(", ");
const itemsText = bestItems.map((item) => item.name).join(", ");
const itemsSuffixText = itemsText ? ` Sus ítems destacados son: ${itemsText}.` : "";

const title =
  data.titulo_seo || `${data.name} TFT - Mejores Comps & Builds (Set ${activeSet})`;
const description =
  data.descripcion_seo ||
  `${data.name} es un campeón de coste ${data.cost} de TFT ${activeSet} que combina los rasgos ${traitsNamesText}.${itemsSuffixText}`;

const currentVersion =
  activeSet === String(setNumberPBE)
    ? version?.MetaCompVersionPBE
    : version?.MetaCompVersion;

const getChampionCostBorder = (cost) => {
  switch (Number(cost)) {
    case 0: return "var(--color-text-highlight)";
    case 1: return "#ffffff";
    case 2: return "#3e9e64";
    case 3: return "#1e69ee";
    case 4: return "#b534f5";
    case 5: return "#f58220";
    case 7: return "#ff66c4";
    default: return "#7b61ff";
  }
};

const champColor = getChampionCostBorder(data.cost);
const heroImgSrc = getLocalTftImage(
  data.tileIcon || data.squareIcon || data.icon,
  "champions/tileIcon",
  activeSet
);
const fallbackImgSrc = getLocalTftImage(data.icon, "champions/icon", activeSet);
const abilityIconSrc = parsedAbility?.icon
  ? (parsedAbility.icon.startsWith("/tft/") || parsedAbility.icon.startsWith("http"))
    ? parsedAbility.icon
    : getLocalTftImage(parsedAbility.icon, "champions/habilidad", activeSet)
  : "";

const parsedStats = safeJsonParse(data.stats, data.stats) || {};
const parsedUnlock = safeJsonParse(data.unlock, data.unlock) || parsedAbility?.unlock || null;
const tooltipTraits = traitsList.map((t) => ({ name: t.name, iconSrc: t.iconSrc }));
---

<LayoutMaxWidth
  title={title}
  description={description}
  snippetImgUrl={resolvedTileIcon || heroImgSrc || data.icon}
>
  <div class="header-section" style={`--champ-color: ${champColor};`}>
    <div class="hero-container">
      <div class="hero-info">
        <div class="badges-row">
          <span class="set-badge">Set {activeSet}</span>
          {currentVersion && (
            <span class="patch-badge">Parche {currentVersion}</span>
          )}
          <span class="cost-pill">Coste {data.cost}</span>
        </div>

        <h1>{data.name} TFT - Mejores Comps & Builds</h1>

        <div class="dataChamp">
          <div class="info-2-champ">
            {/* Columna izquierda: Imagen (con tooltip estilo card Set 19) + Sinergias + Objetos recomendados */}
            <div class="hero-image-wrapper">
              <CampeonHeroTooltip
                name={data.name}
                cost={data.cost}
                champColor={champColor}
                heroImgSrc={heroImgSrc}
                fallbackImgSrc={fallbackImgSrc}
                activeSet={activeSet}
                traits={tooltipTraits}
                role={data.role || ""}
                range={parsedStats?.range ?? null}
                manaInitial={parsedStats?.initialMana ?? 0}
                manaMax={parsedStats?.mana ?? 0}
                unlock={parsedUnlock}
                abilityName={parsedAbility?.name || data.ability_name || ""}
                abilityIconSrc={abilityIconSrc}
                abilityDescHtml={abilityDescFormatted}
                client:load
              />

              <div class="containerTraits">
                {traitsList.map((t) => (
                  <a
                    href={`/tft/meta-comps-tier-list-teamfight-tactics/${t.slug}`}
                    class="trait-badge"
                  >
                    {t.iconSrc && (
                      <img
                        src={t.iconSrc}
                        alt={t.name}
                        class="trait-icon"
                      />
                    )}
                    <span>{t.name}</span>
                  </a>
                ))}
              </div>

              {bestItems.length > 0 && (
                <div class="left-rec-items">
                  {bestItems.map((item) => (
                    <a
                      href={`/tft/meta-comps-tier-list-teamfight-tactics/${item.slug}`}
                      class="left-rec-item-link"
                      title={item.name}
                    >
                      <img
                        src={item.iconSrc}
                        alt={item.name}
                        loading="lazy"
                      />
                    </a>
                  ))}
                </div>
              )}
            </div>

            {/* Columna derecha: los 2 párrafos descriptivos + Tip Jupeson + Video */}
            <div class="containerInfoChamp">
              {firstCompTipSeoLower && (
                <p class="seo-desc">
                  La mejor composición para <span class="colored-text">{data.name}</span> es {firstCompTipSeoLower}
                </p>
              )}

              <p class="seo-desc">
                <span class="colored-text">{data.name}</span> es un campeón de{" "}
                <span class="colored-text">coste {data.cost}</span> de TFT {activeSet}{traitsNamesText ? (
                  <>
                    {" "}que combina los rasgos{" "}
                    <span class="colored-text">{traitsNamesText}</span>
                  </>
                ) : (
                  ""
                )}.{bestItems.length > 0 ? (
                  <>
                    {" "}Sus ítems destacados son:{" "}
                    <span class="colored-text">{itemsText}</span>.
                  </>
                ) : (
                  ""
                )}
              </p>

              {data.tip_jupeson && (
                <div class="tip-jupeson-container">
                  <span class="tip-jupeson-title">💡 Tip Jupeson:</span>
                  <span class="tip-jupeson-text">{data.tip_jupeson}</span>
                </div>
              )}

              {data.video_url && (
                <div class="video-block">
                  <h3>Video Guía</h3>
                  <div class="container-video">
                    <Youtube src={data.video_url} client:load />
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Composiciones agrupadas por set (sin el CTA aquí, porque el CTA va debajo del todo) */}
    <CompsPorSet
      entityName={data.name}
      entityType="campeon"
      newestSetNumber={activeSet}
      compsBySet={compsBySet}
      hideCta={true}
      client:load
    />

    {/* Mejores Objetos y Builds del campeón */}
    {bestItems.length > 0 && (
      <section class="builds-section">
        <h2>Mejores Objetos y Builds para {data.name} en TFT</h2>
        <div class="builds-items-grid">
          {bestItems.map((item) => (
            <a
              href={`/tft/meta-comps-tier-list-teamfight-tactics/${item.slug}`}
              class="build-item-card"
              title={item.name}
            >
              <img src={item.iconSrc} alt={item.name} loading="lazy" />
              <span>{item.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Secciones Dinámicas */}
    {Array.isArray(parsedSecciones) && parsedSecciones.length > 0 && (
      <div class="dynamic-sections">
        {parsedSecciones.map((sec) => (
          <div class="section-block">
            <h2>{sec.titulo}</h2>
            <div class="section-content" set:html={sec.descripcion} />
          </div>
        ))}
      </div>
    )}

    {/* CTA final debajo del todo */}
    <div class="cta-banner">
      ¿Buscas más opciones para subir de rango? Explora todas las{" "}
      <a
        class="cta-link"
        href="/tft/meta-comps-tier-list-teamfight-tactics/"
      >
        Meta Comps de TFT
      </a>{" "}
      actualizadas al parche actual.
    </div>
  </div>
</LayoutMaxWidth>

<style>
  .header-section {
    width: 100%;
    margin: 0 auto 30px auto;
    max-width: 900px;
    background: linear-gradient(135deg, rgba(18, 16, 52, 0.88), rgba(18, 16, 52, 0.55));
    padding: 28px;
    border-radius: 16px;
    border: 1px solid var(--champ-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    align-self: center;
  }

  .hero-container {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .set-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-text-highlight), #63e6ff);
    color: #0b0920;
  }

  .patch-badge,
  .cost-pill {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
  }

  .hero-info {
    flex-grow: 1;
    gap: 14px;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .hero-info h1 {
    font-size: 2.15rem;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .dataChamp {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-2-champ {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: 24px;
    align-items: flex-start;
  }

  .hero-image-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 0 0 156px;
    width: 156px;
    align-self: flex-start;
  }

  .containerTraits {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    width: 100%;
  }

  .trait-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(10, 9, 28, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 0.82rem;
    color: #ffffff;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trait-badge:hover {
    border-color: var(--color-text-highlight);
    background: rgba(123, 97, 255, 0.35);
  }

  .trait-icon {
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));
  }

  /* Objetos recomendados compactos debajo de las sinergias */
  .left-rec-items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    padding-top: 4px;
  }

  .left-rec-item-link {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .left-rec-item-link:hover {
    transform: scale(1.08);
    border-color: var(--color-text-highlight);
  }

  .left-rec-item-link img {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    object-fit: cover;
  }

  .containerInfoChamp {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-width: 0;
  }

  .colored-text {
    color: #ff9fd8;
    font-weight: 600;
  }

  .seo-desc {
    font-size: 1.02rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  .tip-jupeson-container {
    padding: 15px;
    background: rgba(123, 97, 255, 0.12);
    border: 1px solid rgba(123, 97, 255, 0.35);
    border-left: 4px solid #a78bfa;
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
  }

  .tip-jupeson-title {
    color: #a78bfa;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .video-block h3 {
    margin: 0 0 8px 0;
    font-size: 1rem;
    color: #ffc832;
  }

  .container-video {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  /* Sección H2: Mejores Objetos y Builds */
  .builds-section {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .builds-section h2 {
    margin: 0;
    font-size: 1.45rem;
    color: #ffffff;
    font-weight: 700;
  }

  .builds-items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 12px;
  }

  .build-item-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 12px 10px;
    border-radius: 12px;
    background: rgba(12, 10, 34, 0.72);
    border: 1px solid rgba(123, 97, 255, 0.3);
    text-decoration: none;
    color: #e2e8f0;
    transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
  }

  .build-item-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-text-highlight);
    background: rgba(28, 22, 66, 0.88);
  }

  .build-item-card img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
  }

  .build-item-card span {
    font-size: 0.8rem;
    line-height: 1.25;
    font-weight: 600;
  }

  .dynamic-sections {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-block {
    background: rgba(16, 13, 42, 0.7);
    border: 1px solid rgba(123, 97, 255, 0.3);
    border-radius: 12px;
    padding: 20px;
  }

  .section-block h2 {
    margin: 0 0 10px 0;
    color: #ffc832;
    font-size: 1.25rem;
  }

  .section-content {
    color: #cbd5e1;
    line-height: 1.6;
  }

  .cta-banner {
    margin-top: 26px;
    background: rgba(33, 28, 71, 0.85);
    border: 1px solid rgba(123, 97, 255, 0.35);
    border-radius: 12px;
    padding: 18px 20px;
    text-align: center;
    color: #e2e8f0;
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .cta-link {
    color: #f5e020;
    font-weight: 700;
    text-decoration: none;
  }

  .cta-link:hover {
    text-decoration: underline;
  }

  @media only screen and (max-width: 900px) {
    .header-section {
      padding: 18px;
    }

    .hero-info h1 {
      font-size: 1.55rem;
    }

    .info-2-champ {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .hero-image-wrapper {
      flex: none;
      width: 100%;
      align-self: center;
    }

    .containerTraits {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .trait-badge {
      width: fit-content;
      padding: 5px 12px;
    }

    .left-rec-items {
      max-width: 220px;
    }

    .containerInfoChamp {
      width: 100%;
    }

    .builds-section h2 {
      font-size: 1.2rem;
    }

    .builds-items-grid {
      grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
      gap: 10px;
    }

    .cta-banner {
      padding: 14px;
      font-size: 0.9rem;
    }
  }
</style>

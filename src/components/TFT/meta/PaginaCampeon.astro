---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import CompsPorSet from "@components/TFT/meta/CompsPorSet.jsx";
import Youtube from "@components/youtube/Youtube.jsx";
import { setNumberPBE } from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import { formatChampionDescription } from "@components/tooltips/functions.jsx";
import {
  compUsesChampion,
  groupCompsBySet,
  normalizeItemApiName,
  safeJsonParse,
  slugifyTftEntity,
} from "@utils/tftEntitySlug.js";

const {
  data,
  entitySetNumber,
  matchingApiNames = [],
  allComps = [],
  setTraits = [],
  setItems = [],
  traitSlugByApi = {},
  itemSlugByApi = {},
  resolvedTileIcon,
  lastUpdate,
  version,
} = Astro.props;

const activeSet = String(entitySetNumber || data.tft_set || setNumberPBE);
const apiNamesToMatch = matchingApiNames.length > 0 ? matchingApiNames : [data.apiName];

// Sinergias del campeón en el set más reciente
const parsedTraits = safeJsonParse(data.traits, data.traits) || [];
const traitsList = (Array.isArray(parsedTraits) ? parsedTraits : []).map((traitKey) => {
  const found = (setTraits || []).find(
    (st) =>
      st.name?.toLowerCase() === String(traitKey).toLowerCase() ||
      st.apiName?.toLowerCase() === String(traitKey).toLowerCase()
  );
  if (found) {
    const slug =
      traitSlugByApi[(found.apiName || "").toLowerCase()] ||
      (found.url_seo ? String(found.url_seo).toLowerCase() : slugifyTftEntity(found.name));
    return { ...found, slug };
  }
  return { name: String(traitKey), icon: "", slug: slugifyTftEntity(traitKey) };
});

// Habilidad del campeón en el set más reciente
const parsedAbility = safeJsonParse(data.ability, { name: "", icon: "", desc: "" }) || {
  name: "",
  icon: "",
  desc: "",
};
const parsedAbilityVars =
  safeJsonParse(data.ability_variables, parsedAbility.variables || []) || [];
const abilityDescFormatted = formatChampionDescription(
  parsedAbility.desc || "",
  parsedAbilityVars
);

// Composiciones relacionadas en TODOS los sets donde aparece este campeón
const relatedComps = (allComps || []).filter((comp) =>
  compUsesChampion(comp, apiNamesToMatch)
);
const compsBySet = groupCompsBySet(relatedComps, activeSet);

// Objetos recomendados: priorizar las compos del set más reciente y luego recomendados del catálogo
const parsedItemsSet = new Set();
const currentSetComps = compsBySet.find((g) => g.setNumber === activeSet)?.comps || [];
const sourceCompsForItems = currentSetComps.length > 0 ? currentSetComps : relatedComps;

const matchSetLower = new Set(apiNamesToMatch.map((a) => String(a).toLowerCase()));
sourceCompsForItems.forEach((comp) => {
  const pos = safeJsonParse(comp.posicionamiento, []);
  if (!Array.isArray(pos)) return;
  pos.forEach((boardVariant) => {
    if (!boardVariant || !Array.isArray(boardVariant.tablero)) return;
    boardVariant.tablero.forEach((cell) => {
      if (!cell) return;
      const cellApi = String(cell.apiNameCampeon || cell.campeon || "").toLowerCase();
      if (matchSetLower.has(cellApi) && Array.isArray(cell.apiNameItemsDelCampeon)) {
        cell.apiNameItemsDelCampeon.forEach((itemApiName) => {
          if (itemApiName) parsedItemsSet.add(itemApiName);
        });
      }
    });
  });
});

// Fallback a recommendedItems del catálogo del set (o dentro de ability) si aún no hay compos del set más reciente
const fallbackRecommended = Array.isArray(data.recommendedItems)
  ? data.recommendedItems
  : Array.isArray(parsedAbility?.recommendedItems)
    ? parsedAbility.recommendedItems
    : [];
if (parsedItemsSet.size === 0 && fallbackRecommended.length > 0) {
  fallbackRecommended.slice(0, 8).forEach((itemEntry) => {
    const api = typeof itemEntry === "object" ? itemEntry?.apiName : itemEntry;
    if (api) parsedItemsSet.add(api);
  });
}

const bestItems = [];
const seenItemIds = new Set();
Array.from(parsedItemsSet).forEach((itemRef) => {
  const normRef = normalizeItemApiName(itemRef);
  const found = (setItems || []).find(
    (i) =>
      normalizeItemApiName(i.apiName) === normRef ||
      i.name?.toLowerCase() === String(itemRef).toLowerCase()
  );
  if (found && !seenItemIds.has(found.apiName)) {
    seenItemIds.add(found.apiName);
    const slug =
      itemSlugByApi[(found.apiName || "").toLowerCase()] ||
      slugifyTftEntity(found.name);
    bestItems.push({ ...found, slug });
  }
});

// Secciones Dinámicas
const parsedSecciones = safeJsonParse(data.secciones, []) || [];

const traitsNamesText = traitsList.map((t) => t.name).join(", ");
const itemsText = bestItems.map((item) => item.name).join(", ");
const itemsSuffixText = itemsText
  ? `, y sus mejores ítems son: ${itemsText}.`
  : ".";

const title =
  data.titulo_seo || `${data.name} TFT Set ${activeSet} — Builds, Items y Comps`;
const description =
  data.descripcion_seo ||
  `${data.name} es un campeón de coste ${data.cost} en TFT Set ${activeSet} con los rasgos ${traitsNamesText}. Descubre sus mejores objetos, habilidad y composiciones meta${itemsSuffixText}`;

const currentVersion =
  activeSet === String(setNumberPBE)
    ? version?.MetaCompVersionPBE
    : version?.MetaCompVersion;

const getChampionCostBorder = (cost) => {
  switch (Number(cost)) {
    case 0: return "#00ffc4";
    case 1: return "#ffffff";
    case 2: return "#3e9e64";
    case 3: return "#1e69ee";
    case 4: return "#b534f5";
    case 5: return "#f58220";
    case 7: return "#ff66c4";
    default: return "#7b61ff";
  }
};

const champColor = getChampionCostBorder(data.cost);
const heroImgSrc = getLocalTftImage(
  data.tileIcon || data.squareIcon || data.icon,
  "champions/tileIcon",
  activeSet
);
const fallbackImgSrc = getLocalTftImage(data.icon, "champions/icon", activeSet);
const abilityIconSrc = parsedAbility?.icon
  ? (parsedAbility.icon.startsWith("/tft/") || parsedAbility.icon.startsWith("http"))
    ? parsedAbility.icon
    : getLocalTftImage(parsedAbility.icon, "champions/habilidad", activeSet)
  : "";
---

<LayoutMaxWidth
  title={title}
  description={description}
  snippetImgUrl={resolvedTileIcon || heroImgSrc || data.icon}
>
  <div class="header-section" style={`--champ-color: ${champColor};`}>
    <div class="hero-container">
      <div class="hero-info">
        <div class="badges-row">
          <span class="set-badge">Set {activeSet}</span>
          {currentVersion && (
            <span class="patch-badge">Parche {currentVersion}</span>
          )}
          <span class="cost-pill">Coste {data.cost}</span>
        </div>

        <h1>{data.name} TFT — Builds, Items & Comps</h1>

        <div class="dataChamp">
          <p class="seo-desc">
            <span class="colored-text">{data.name}</span> es un campeón de{" "}
            <span class="colored-text">coste {data.cost}</span> de TFT Set{" "}
            {activeSet}{traitsNamesText ? (
              <>
                {" "}que combina los rasgos{" "}
                <span class="colored-text">{traitsNamesText}</span>
              </>
            ) : (
              ""
            )}. Aquí encontrarás sus mejores objetos, habilidad actualizada y las
            composiciones que lo utilizan en el meta{bestItems.length > 0 ? (
              <>
                . Sus ítems destacados son:{" "}
                <span class="colored-text">{itemsText}</span>.
              </>
            ) : (
              "."
            )}
          </p>

          {data.tip_jupeson && (
            <div class="tip-jupeson-container">
              <span class="tip-jupeson-title">💡 Tip Jupeson:</span>
              <span class="tip-jupeson-text">{data.tip_jupeson}</span>
            </div>
          )}

          <div class="info-2-champ">
            <div class="hero-image-wrapper">
              <div class="champ-portrait-box">
                <img
                  src={heroImgSrc}
                  alt={`${data.name} TFT Set ${activeSet}`}
                  class="champ-hero-img"
                  onerror={`this.onerror=null; this.src='${fallbackImgSrc}';`}
                />
                <div class="cost-badge">{data.cost}</div>
              </div>
              <div class="containerTraits">
                {traitsList.map((t) => (
                  <a
                    href={`/tft/meta-comps-tier-list-teamfight-tactics/${t.slug}`}
                    class="trait-badge"
                  >
                    {t.icon && (
                      <img
                        src={getLocalTftImage(t.icon, "traits", activeSet)}
                        alt={t.name}
                        class="trait-icon"
                      />
                    )}
                    <span>{t.name}</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="containerInfoChamp">
              {/* Habilidad del campeón (Set más reciente) */}
              {(parsedAbility?.name || abilityDescFormatted) && (
                <div class="ability-card">
                  <div class="ability-header">
                    {abilityIconSrc && (
                      <img
                        src={abilityIconSrc}
                        alt={parsedAbility.name || `Habilidad de ${data.name}`}
                        class="ability-icon"
                        onerror="this.style.display='none';"
                      />
                    )}
                    <div>
                      <span class="ability-tag">Habilidad · Set {activeSet}</span>
                      <h3>{parsedAbility.name || "Habilidad"}</h3>
                    </div>
                  </div>
                  {abilityDescFormatted && (
                    <div
                      class="ability-desc"
                      set:html={abilityDescFormatted}
                    />
                  )}
                </div>
              )}

              {/* Mejores Ítems en el Hero */}
              {bestItems.length > 0 && (
                <div class="hero-items-container">
                  <h3 class="hero-items-title">Objetos Recomendados</h3>
                  <div class="hero-items-list">
                    {bestItems.map((item) => (
                      <a
                        href={`/tft/meta-comps-tier-list-teamfight-tactics/${item.slug}`}
                        class="hero-item-card"
                        title={item.name}
                      >
                        <img
                          src={getLocalTftImage(item.icon, "items", activeSet)}
                          alt={item.name}
                        />
                        <span>{item.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {/* Video YouTube */}
              {data.video_url && (
                <div class="video-block">
                  <h3>Video Guía</h3>
                  <div class="container-video">
                    <Youtube src={data.video_url} client:load />
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Composiciones agrupadas por set: Set más reciente abierto y anteriores desplegables */}
    <CompsPorSet
      entityName={data.name}
      entityType="campeon"
      newestSetNumber={activeSet}
      compsBySet={compsBySet}
      client:load
    />

    {/* Secciones Dinámicas */}
    {Array.isArray(parsedSecciones) && parsedSecciones.length > 0 && (
      <div class="dynamic-sections">
        {parsedSecciones.map((sec) => (
          <div class="section-block">
            <h2>{sec.titulo}</h2>
            <div class="section-content" set:html={sec.descripcion} />
          </div>
        ))}
      </div>
    )}
  </div>
</LayoutMaxWidth>

<style>
  .header-section {
    width: 100%;
    margin: 0 auto 30px auto;
    max-width: 900px;
    background: linear-gradient(135deg, rgba(18, 16, 52, 0.88), rgba(18, 16, 52, 0.55));
    padding: 28px;
    border-radius: 16px;
    border: 1px solid var(--champ-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    align-self: center;
  }

  .hero-container {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .set-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: linear-gradient(135deg, #00ffc4, #63e6ff);
    color: #0b0920;
  }

  .patch-badge,
  .cost-pill {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
  }

  .containerInfoChamp {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    min-width: 0;
  }

  .hero-image-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 0 0 144px;
    width: 144px;
    align-self: flex-start;
  }

  .champ-portrait-box {
    position: relative;
    width: 132px;
    height: 132px;
    flex-shrink: 0;
  }

  .containerTraits {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    width: 100%;
  }

  .champ-hero-img {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    object-fit: cover;
    display: block;
    border: 3px solid var(--champ-color);
    box-shadow: 0 0 14px var(--champ-color);
  }

  .cost-badge {
    position: absolute;
    bottom: -8px;
    right: -8px;
    background: #121034;
    border: 2px solid var(--champ-color);
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.95rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .hero-info {
    flex-grow: 1;
    gap: 14px;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .colored-text {
    color: #ff9fd8;
    font-weight: 600;
  }

  .hero-info h1 {
    font-size: 2.15rem;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .dataChamp {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .trait-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(10, 9, 28, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 0.82rem;
    color: #ffffff;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .trait-badge:hover {
    border-color: #00ffc4;
    background: rgba(123, 97, 255, 0.35);
  }

  .trait-icon {
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));
  }

  .seo-desc {
    font-size: 1.02rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0;
  }

  .tip-jupeson-container {
    padding: 15px;
    background: rgba(123, 97, 255, 0.12);
    border: 1px solid rgba(123, 97, 255, 0.35);
    border-left: 4px solid #a78bfa;
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
  }

  .tip-jupeson-title {
    color: #a78bfa;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .info-2-champ {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: 22px;
  }

  /* Habilidad */
  .ability-card {
    background: rgba(10, 9, 28, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ability-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ability-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    object-fit: cover;
  }

  .ability-tag {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #00ffc4;
    font-weight: 700;
  }

  .ability-header h3 {
    margin: 2px 0 0 0;
    font-size: 1.1rem;
    color: #ffffff;
  }

  .ability-desc {
    font-size: 0.94rem;
    line-height: 1.55;
    color: #e2e8f0;
  }

  .ability-desc :global(img) {
    width: 15px;
    height: 15px;
    vertical-align: middle;
    margin: 0 2px;
  }

  /* Hero Items */
  .hero-items-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero-items-title {
    font-size: 1rem;
    color: #ffffff;
    margin: 0;
  }

  .hero-items-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-item-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 5px;
    text-decoration: none;
    width: 64px;
    transition: transform 0.2s ease;
  }

  .hero-item-card:hover {
    transform: translateY(-2px);
  }

  .hero-item-card img {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .hero-item-card span {
    font-size: 0.72rem;
    color: #cbd5e1;
    line-height: 1.15;
  }

  .video-block h3 {
    margin: 0 0 8px 0;
    font-size: 1rem;
    color: #ffc832;
  }

  .container-video {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .dynamic-sections {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-block {
    background: rgba(16, 13, 42, 0.7);
    border: 1px solid rgba(123, 97, 255, 0.3);
    border-radius: 12px;
    padding: 20px;
  }

  .section-block h2 {
    margin: 0 0 10px 0;
    color: #ffc832;
    font-size: 1.25rem;
  }

  .section-content {
    color: #cbd5e1;
    line-height: 1.6;
  }

  @media only screen and (max-width: 900px) {
    .header-section {
      padding: 18px;
    }

    .hero-info h1 {
      font-size: 1.55rem;
    }

    .info-2-champ {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .hero-image-wrapper {
      flex: none;
      width: 100%;
      align-self: center;
    }

    .champ-portrait-box {
      width: 128px;
      height: 128px;
    }

    .containerTraits {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .trait-badge {
      width: fit-content;
      padding: 5px 12px;
    }

    .containerInfoChamp {
      width: 100%;
    }
  }
</style>

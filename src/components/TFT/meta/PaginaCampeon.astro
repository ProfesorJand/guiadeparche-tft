---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import CardsCompos from "@components/TFT/CardsCompos.jsx";
import Youtube from "@components/youtube/Youtube.jsx";
import { setNumberPBE, setNumberLatest, dataTFTTraits, dataTFTAllItems } from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import { formatChampionDescription } from "@components/tooltips/functions.jsx";

const { data, allComps, resolvedTileIcon, lastUpdate, version } = Astro.props;

// Stores
const safeSinergiasData = dataTFTTraits.get() || [];
const safeGlobalItems = dataTFTAllItems.get() || [];

// Sinergias (Traits) - `traits` array of strings (e.g. "Rebel", "Sniper")
let parsedTraits = [];
if (data.traits) {
  try {
    parsedTraits = typeof data.traits === 'string' ? JSON.parse(data.traits) : data.traits;
  } catch(e) {}
}

const traitsList = parsedTraits.map(traitName => {
  const t = safeSinergiasData.find(st => st.name === traitName || st.apiName === traitName);
  return t ? t : { name: traitName, icon: '' };
});

// Habilidad (Ability)
let parsedAbility = { name: "", icon: "", desc: "" };
if (data.ability) {
  try {
    parsedAbility = typeof data.ability === 'string' ? JSON.parse(data.ability) : data.ability;
  } catch(e) {}
}

let parsedAbilityVars = [];
if (data.ability_variables) {
  try {
    parsedAbilityVars = typeof data.ability_variables === 'string' ? JSON.parse(data.ability_variables) : data.ability_variables;
  } catch (e) { }
}

const abilityDescFormatted = formatChampionDescription(parsedAbility.desc || "", parsedAbilityVars);

// Related Comps
const relatedComps = allComps.filter(comp => {
  if (!comp.posicionamiento) return false;
  let pos = comp.posicionamiento;
  if (typeof pos === 'string') {
    try { pos = JSON.parse(pos); } catch(e) { return false; }
  }
  
  if (Array.isArray(pos)) {
    return pos.some(boardVariant => {
      if (boardVariant && Array.isArray(boardVariant.tablero)) {
        return boardVariant.tablero.some(cell => cell && (cell.apiNameCampeon === data.apiName || cell.campeon === data.apiName));
      }
      return false;
    });
  }
  return false;
});

// Item Combinations (Obtenidos de las composiciones relacionadas)
let parsedItemsSet = new Set();

relatedComps.forEach(comp => {
  let pos = comp.posicionamiento;
  if (typeof pos === 'string') {
    try { pos = JSON.parse(pos); } catch(e) { return; }
  }
  if (Array.isArray(pos)) {
    pos.forEach(boardVariant => {
      if (boardVariant && Array.isArray(boardVariant.tablero)) {
        boardVariant.tablero.forEach(cell => {
          if (cell && (cell.apiNameCampeon === data.apiName || cell.campeon === data.apiName)) {
            if (Array.isArray(cell.apiNameItemsDelCampeon)) {
              cell.apiNameItemsDelCampeon.forEach(itemApiName => {
                if (itemApiName) {
                  parsedItemsSet.add(itemApiName);
                }
              });
            }
          }
        });
      }
    });
  }
});

const bestItems = [];
const seenItemIds = new Set();
Array.from(parsedItemsSet).forEach(itemName => {
  const found = safeGlobalItems.find(i => i.name === itemName || i.apiName === itemName);
  if (found && !seenItemIds.has(found.apiName)) {
    seenItemIds.add(found.apiName);
    bestItems.push(found);
  }
});

// Secciones Dinámicas
let parsedSecciones = [];
if (data.secciones) {
  try {
    parsedSecciones = typeof data.secciones === 'string' ? JSON.parse(data.secciones) : data.secciones;
  } catch(e) {}
}

const title = data.titulo_seo || `${data.name} TFT - Builds, Items & Comps`;
const itemsText = bestItems.map(item => item.name).join(', ');
const itemsSuffixText = itemsText ? `, y los mejores items son: ${itemsText}.` : '. Este campeón no tiene objetos recomendados.';
const description = data.descripcion_seo || `${data.name} es un campeón de coste ${data.cost} de TFT Set ${data.tft_set} que combina los rasgos ${data.traits.replace(/[\\[\\]]/g, '')}. En esta página encontrarás los mejores objetos para ${data.name} TFT, las composiciones que lo utilizan y las recomendaciones para aprovecharlo en el meta actual${itemsSuffixText}`;
const currentVersion = String(data.tft_set) === String(setNumberPBE) ? version.MetaCompVersionPBE : version.MetaCompVersion;

function getChampionCostBorder(cost) {
  switch (Number(cost)) {
    case 1: return "#ffffff"; // Blanco/Gris
    case 2: return "#3e9e64"; // Verde
    case 3: return "#1e69ee"; // Azul
    case 4: return "#b534f5"; // Morado
    case 5: return "#f58220"; // Naranja/Dorado
    default: return "#444";
  }
}
const champColor = getChampionCostBorder(data.cost);
console.log({video:data.video_url})
---

<LayoutMaxWidth
  title={title}
  description={description}
  snippetImgUrl={resolvedTileIcon || data.icon || data.squareIcon}
>
  <div class="header-section" style={`--champ-color: ${champColor};`}>
    <div class="hero-container">
     
      <div class="hero-info">
        <h1>{data.name} TFT - Builds, Items & Comps</h1>
        <div class="dataChamp">
           <p class="seo-desc"><span class="colored-text">{data.name}</span> es un campeón de <span class="colored-text">coste {data.cost}</span> de TFT Set {data.tft_set} que combina los rasgos <span class="colored-text">{traitsList.map(t => t.name).join(', ')}</span>. En esta página encontrarás los mejores builds para <span class="colored-text">{data.name}</span>, las composiciones que lo utilizan y recomendaciones para aprovecharlo en el meta actual{bestItems.length > 0 ? <>. Sus mejores items son: <span class="colored-text">{bestItems.map(i => i.name).join(', ')}</span>.</> : '. Este campeón no tiene objetos recomendados.'}  
          </p>
          
          <div class="info-2-champ">
            <div class="hero-image-wrapper">
              <img 
                src={getLocalTftImage(data.tileIcon || data.squareIcon || data.icon, 'champions/tile/Icon', data.tft_set || "18")} 
                alt={data.name}
                class="champ-hero-img"
                onerror={`this.onerror=null; this.src='${getLocalTftImage(data.icon, 'champions/icon', data.tft_set || "18")}';`}
              />
              <div class="cost-badge">{data.cost}</div>
              <div class="containerTraits">
                {traitsList.map(t => {
                  const isLink = Boolean(t.url_seo);
                  const content = (
                    <>
                      {t.icon && (
                        <img 
                        src={getLocalTftImage(t.icon, 'traits', data.tft_set || "18")} 
                        alt={t.name}
                        class="trait-icon"
                        />
                      )}
                      <span>{t.name}</span>
                    </>
                  );

                  return isLink ? (
                    <a href={`/tft/meta-comps-tier-list-teamfight-tactics/${t.url_seo.toLowerCase()}`} class="trait-badge" style="text-decoration: none; color: inherit; cursor: pointer;">
                      {content}
                    </a>
                  ) : (
                    <div class="trait-badge">
                      {content}
                    </div>
                  );
                })}
              </div>
            </div>
            
            <div class="containerInfoChamp">
              <div class="containerTraits-mobile">
                {traitsList.map(t => {
                  const isLink = Boolean(t.url_seo);
                  const content = (
                    <>
                      {t.icon && (
                        <img 
                        src={getLocalTftImage(t.icon, 'traits', data.tft_set || "18")} 
                        alt={t.name}
                        class="trait-icon"
                        />
                      )}
                      <span>{t.name}</span>
                    </>
                  );

                  return isLink ? (
                    <a href={`/tft/meta-comps-tier-list-teamfight-tactics/${t.url_seo.toLowerCase()}`} class="trait-badge" style="text-decoration: none; color: inherit; cursor: pointer;">
                      {content}
                    </a>
                  ) : (
                    <div class="trait-badge">
                      {content}
                    </div>
                  );
                })}
              </div>
              {/* Mejores Ítems en el Hero */}
              {bestItems.length > 0 && (
                <div class="hero-items-container">
                  <h3 class="hero-items-title">Objetos Recomendados</h3>
                  <div class="hero-items-list">
                    {bestItems.map(item => (
                      <div class="hero-item-card">
                        <img 
                          src={getLocalTftImage(item.icon, 'items', data.tft_set || "18")} 
                          alt={item.name}
                          title={item.name}
                        />
                        {/* <span>{item.name}</span> */}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Video YouTube */}
              {data.video_url && (
                <div class="section-block video-block glass-panel">
                  <h2>Video Guía</h2>
                  <div class="container-video">
                    <Youtube src={data.video_url} client:load />
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- <p class="update-info">Última actualización: {lastUpdate} | Parche {currentVersion}</p> -->
      </div>
    </div>
  



  {/* Compos Relacionadas a Ancho Completo */}
  {relatedComps.length > 0 ? (
    <div class="containerMejoresComps">
      <h2>Mejores Comps de {data.name} TFT</h2>
      <p class="text-centered">Estas son las mejores comps de TFT que utilizan a {data.name} en el meta actual. Explora cada composición para conocer sus campeones, objetos, builds y condiciones recomendadas para jugarla.</p>
      <div class="comps-grid">
        {relatedComps.map((comp, index) => (
          <article class="comp-card" style="margin-bottom: 20px;">
            <CardsCompos
              comp={comp}
              numeracion={index + 1}
              expandInline={true}
              client:load
            />
          </article>
        ))}
      </div>
      <div class="trait-main-card">
        <p class="text-centered">¿Buscas más opciones? Explora todas las <a style="color:#f5e020ff; font-weight: bold;" href="/tft/meta-comps-tier-list-teamfight-tactics/">Meta Comps de TFT</a> actualizadas para encontrar qué jugar en el parche actual.</p>
      </div>
    </div>
  ) : (
  <div class="containerMejoresComps">
    <p>En estos momentos no existen compos para el campeon {data.name}</p>
  </div>
  )}

   <div class="side-column"> 
      {/* Secciones Dinámicas */}
      {parsedSecciones.length > 0 && (
        <div class="dynamic-sections">
          {parsedSecciones.map(sec => (
            <div class="section-block glass-panel" style="margin-bottom: 20px;">
              <h2>{sec.titulo}</h2>
              <div class="section-content" set:html={sec.descripcion} />
            </div>
          ))}
        </div>
      )}
      
    </div>
</div>
</LayoutMaxWidth>

<style>
  /* Root Variables */
  .header-section {
    width: 100%;
    margin-bottom: 30px;
    max-width: 900px;
    background: linear-gradient(135deg, rgba(18, 16, 52, 0.8), rgba(18, 16, 52, 0.4));
    padding: 30px;
    border-radius: 16px;
    border: 1px solid var(--champ-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    align-self: center;
  }

  .hero-container {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .containerInfoChamp{
    display:flex;
    flex-direction:column;
    gap: 15px;
    flex:4
  }
  .containerTraits{
    display: flex;
    position:absolute;
    bottom:0;
    left: 5px;
    flex-direction: column;
    gap: 5px;
    flex:1;
  }

  .hero-image-wrapper {
    position: relative;
    flex:2;
    flex-shrink: 0;
  }

  .champ-hero-img {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    object-fit: cover;
    border: 3px solid var(--champ-color);
    box-shadow: 0 0 15px var(--champ-color);
  }

  .cost-badge {
    position: absolute;
    bottom: -10px;
    right: -10px;
    background: #121034;
    border: 2px solid var(--champ-color);
    color: #fff;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.2rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    border: 2px solid #121034;
  }

  .hero-info {
    flex-grow: 1;
  }
  .colored-text{
    color:#ff9fd8;
  }

  .hero-info h1 {
    font-size: 2.5rem;
    margin: 0 0 10px 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .dataChamp {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .role-badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: bold;
    color: #00ffc4;
  }

  .trait-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    width: fit-content;
  }

  .trait-icon {
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 0 2px rgba(255,255,255,0.5));
  }

  .seo-desc {
    font-size: 1.1rem;
    color: #cbd5e1;
    margin: 0 0 5px 0;
  }

  .update-info {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  h2{
    margin-block-start: 0;
    margin-block-end: 0;
  }

  .containerMejoresComps{
    display:flex;
    flex-direction: column;
    gap:15px;
  }

  .text-centered{
    text-align:center;
    margin-block-start: 0;
    margin-block-end: 0;
  }

  .info-2-champ{
    display:flex;
    flex-direction:row;
    width:100%;
    gap: 20px;
  }

  /* Layout */
  .two-columns {
    display: flex;
    gap: 2rem;
    max-width: 900px;
    margin-bottom: 30px;
  }

  .main-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .side-column {
    width: 350px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Ability Block */
  .ability-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
    background: rgba(0,0,0,0.3);
    padding: 15px;
    border-radius: 10px;
  }

  .ability-icon {
    width: 50px;
    height: 50px;
    border-radius: 8px;
    border: 2px solid #cbd5e1;
  }

  .ability-header h3 {
    margin: 0;
    font-size: 1.3rem;
    color: #fff;
  }

  .ability-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #e2e8f0;
  }
  
  .ability-desc :global(img) {
    width: 16px;
    height: 16px;
    vertical-align: middle;
    margin: 0 2px;
  }

  /* Items Grid */
  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 15px;
  }

  .item-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .item-card img {
    width: 50px;
    height: 50px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }

  .item-card span {
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.2;
  }

  .container-video {
    width: 100%;
    aspect-ratio: 16/9;
  }

  .section-content {
    color: #cbd5e1;
    line-height: 1.6;
  }
  
  .section-content :global(p) {
    margin-top: 0;
  }

  .comps-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .related-comps-section{
    max-width: 900px;
    align-self: center;
  }

  /* Hero Items (Objetos recomendados en cabecera) */
  .hero-items-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-items-title {
    font-size: 1rem;
    color: #fff;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }

  .hero-items-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-item-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 5px;
  }

  .hero-item-card img {
    width: 35px;
    height: 35px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
  }

  .hero-item-card span {
    font-size: 0.75rem;
    color: #cbd5e1;
    max-width: 60px;
    line-height: 1.1;
  }

  @media (max-width: 900px) {
    .two-columns {
      flex-direction: column;
    }
    .side-column {
      width: 100%;
    }
    .hero-container {
      flex-direction: column;
      text-align: center;
    }
    .dataChamp{
      justify-content: center;
    }
    .containerTraits-mobile{
      display:flex;
      flex-direction:row;
      flex-wrap: balance;
      gap:10px;
    }
    .containerTraits{
      display:none;
    }
  }
</style>

---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import CompsPorSet from "@components/TFT/meta/CompsPorSet.jsx";
import Youtube from "@components/youtube/Youtube.jsx";
import { setNumberPBE } from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import ImgTrait from "@components/TFT/ImgTrait.jsx";
import {
  calculateBoardSynergies,
  groupCompsBySet,
  safeJsonParse,
  slugifyTftEntity,
} from "@utils/tftEntitySlug.js";

const {
  data,
  entitySetNumber,
  matchingApiNamesBySet = {},
  setDataBySet = {},
  allComps = [],
  lastUpdate,
  version,
  allChampions = [],
  allTraits = [],
  champSlugByApi = {},
} = Astro.props;

const activeSet = String(entitySetNumber || data.tft_set || setNumberPBE);

// Datos crudos de la sinergia en el set más reciente
const currentTraitData =
  (allTraits || []).find((t) => t.apiName === data.apiName) || data || {};

const currentEffects = safeJsonParse(currentTraitData.effects, currentTraitData.effects) || [];

// Evaluar composiciones de TODOS los sets donde existe esta sinergia (por slug compartido)
const relatedComps = (allComps || []).filter((comp) => {
  const compSet = String(comp?.set_number || activeSet);
  const targetApisForSet =
    matchingApiNamesBySet[compSet] ||
    (compSet === activeSet ? [data.apiName] : []);

  if (!targetApisForSet.length || !comp.posicionamiento) return false;

  const pos = safeJsonParse(comp.posicionamiento, []);
  const tablero = Array.isArray(pos) ? pos[0]?.tablero : null;
  if (!Array.isArray(tablero)) return false;

  const setCatalog = setDataBySet[compSet] || {
    champions: allChampions,
    items: [],
    traits: allTraits,
  };

  const activeSynergies = calculateBoardSynergies(
    tablero,
    setCatalog.champions || [],
    setCatalog.items || [],
    setCatalog.traits || []
  );

  return targetApisForSet.some((traitApi) => {
    const traitLow = String(traitApi).toLowerCase();
    const traitObj = (setCatalog.traits || []).find(
      (t) => t.apiName?.toLowerCase() === traitLow
    );
    const traitEffects = safeJsonParse(traitObj?.effects, traitObj?.effects) || [];
    const minRequired =
      Array.isArray(traitEffects) && traitEffects.length > 0
        ? Math.min(...traitEffects.map((e) => Number(e.minUnits) || 1))
        : 1;
    const count = activeSynergies[traitLow] || 0;
    return count >= minRequired;
  });
});

const compsBySet = groupCompsBySet(relatedComps, activeSet);

const displayName = data.name || data.titulo_seo || "Sinergia";
const displayHeadline = data.titulo_seo || displayName;
const title =
  data.titulo_seo
    ? `TFT ${data.titulo_seo} Set ${activeSet} — Meta Comps y Campeones`
    : `${displayName} TFT Set ${activeSet} — Sinergia, Campeones y Composiciones`;
const description =
  data.descripcion_seo ||
  `Descubre cómo funciona la sinergia ${displayName} en TFT Set ${activeSet}, sus campeones y las mejores composiciones meta.`;
const currentVersion =
  activeSet === String(setNumberPBE)
    ? version?.MetaCompVersionPBE
    : version?.MetaCompVersion;

const parsedSecciones = safeJsonParse(data.secciones, []) || [];
const parsedCustomEffects = safeJsonParse(data.effects, []) || [];

// Formatear descripción cruda de la sinergia si no viene texto editorial `desc_trait`
const formatTraitRawDesc = (rawDesc = "") => {
  if (!rawDesc) return "";
  return String(rawDesc)
    .replace(/<expandRow>[\s\S]*?<\/expandRow>/gi, "")
    .replace(/<row>[\s\S]*?<\/row>/gi, "")
    .replace(/@[a-zA-Z0-9_.:*]+@/g, "")
    .replace(/<\/?(tftitemrules|scaleLevel|TFTBonus)[^>]*>/gi, "")
    .replace(/(<br\s*\/?>\s*){3,}/gi, "<br /><br />")
    .trim();
};

const traitDescHtml = data.desc_trait
  ? data.desc_trait.replace(/\n/g, "<br />")
  : formatTraitRawDesc(currentTraitData.desc || "");

// Procesar Markdown básico en secciones editoriales
const procesarTexto = (texto) => {
  if (!texto) return "";
  let parseado = texto.replace(
    /!\[([^\]]+)\]\(([^)]+)\)/g,
    '<figure class="imagen-dinamica"><img src="$2" alt="$1" /><figcaption>$1</figcaption></figure>'
  );
  parseado = parseado.replace(
    /(?<!!)\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="link-dinamico">$1</a>'
  );

  return parseado
    .split("\n")
    .map((linea) => {
      const trimmed = linea.trim();
      if (!trimmed) return "";
      if (trimmed.startsWith("<figure")) return trimmed;
      return `<p>${trimmed}</p>`;
    })
    .filter(Boolean)
    .join("");
};

// Campeones de esta sinergia en el set más reciente
const championsInTrait = (allChampions || [])
  .filter((c) => {
    const cTraits = safeJsonParse(c.traits, c.traits) || [];
    if (!Array.isArray(cTraits)) return false;
    return cTraits.some(
      (t) =>
        String(t).toLowerCase() === String(data.apiName || "").toLowerCase() ||
        String(t).toLowerCase() === String(data.name || "").toLowerCase()
    );
  })
  .sort((a, b) => {
    if (Number(a.cost) !== Number(b.cost)) return Number(a.cost) - Number(b.cost);
    return (a.name || "").localeCompare(b.name || "");
  });

const styleMapping = {
  1: "hex-bronze.webp",
  2: "hex-bronze.webp",
  3: "hex-silver.webp",
  4: "hex-gold.webp",
  5: "hex-gold.webp",
  6: "hex-prismatic.webp",
  7: "hex-prismatic.webp",
};

const colorHex = {
  bronze: "#a16f44",
  silver: "#909090",
  gold: "#b8860b",
  prismatic: {},
  default: "#333333",
};

const checkColor = (hexColor) => {
  if (!hexColor) return { backgroundColor: colorHex.default };
  if (hexColor === "hex-prismatic.webp") return colorHex.prismatic;
  const colorKey = hexColor.replace("hex-", "").replace(".webp", "");
  return { backgroundColor: colorHex[colorKey] || colorHex.default };
};

const getChampionCostBorder = (cost) => {
  switch (Number(cost)) {
    case 0: return "#00ffc4";
    case 1: return "#ffffff";
    case 2: return "#3e9e64";
    case 3: return "#1e69ee";
    case 4: return "#b534f5";
    case 5: return "#f5e020";
    case 7: return "#ff66c4";
    default: return "#444444";
  }
};

const resolvedIcon = data.icon?.startsWith("http")
  ? data.icon
  : getLocalTftImage(data.icon, "traits", activeSet);
---

<LayoutMaxWidth
  title={title}
  description={description}
  snippetImgUrl={resolvedIcon}
>
  <div class="header-section">
    <div class="trait-main-card two-columns">
      <div class={`container-info-left ${!data.video_url ? "full-width" : ""}`}>
        <div class="trait-header">
          <div class="trait-icon-bg">
            <ImgTrait trait={data} version={activeSet} showName={false} />
          </div>
          <div class="trait-title-wrap">
            <div class="badges-row">
              <span class="set-badge">Set {activeSet}</span>
              {currentVersion && (
                <span class="patch-badge">Parche {currentVersion}</span>
              )}
            </div>
            <h1>
              TFT {displayHeadline} — Meta Comps & Builds (Set {activeSet})
            </h1>
          </div>
        </div>

        {traitDescHtml && (
          <div class="trait-desc" set:html={traitDescHtml} />
        )}

        {data.tip_jupeson && (
          <div class="tip-jupeson-container">
            <span class="tip-jupeson-title">💡 Tip Jupeson:</span>
            <span class="tip-jupeson-text">{data.tip_jupeson}</span>
          </div>
        )}

        {championsInTrait.length > 0 && (
          <div class="champions-section-wrap">
            <h2 class="sub-heading">Campeones de {displayName} (Set {activeSet})</h2>
            <div class="list-champions">
              {championsInTrait.map((c) => {
                const tileIcon = c.tileIcon
                  ? getLocalTftImage(c.tileIcon, "champions/tileIcon", activeSet)
                  : "";
                const champSlug =
                  champSlugByApi[(c.apiName || "").toLowerCase()] ||
                  slugifyTftEntity(c.name);
                const cTraits = safeJsonParse(c.traits, c.traits) || [];

                return (
                  <a
                    href={`/tft/meta-comps-tier-list-teamfight-tactics/${champSlug}`}
                    class="champion-hex-container"
                  >
                    <div
                      class="champion-hex-shape"
                      style={`background-color: ${getChampionCostBorder(c.cost)};`}
                    >
                      {tileIcon && (
                        <img
                          src={tileIcon}
                          alt={`Campeón ${c.name} de sinergia ${displayName} Set ${activeSet}`}
                        />
                      )}
                    </div>
                    <span class="champion-name">{c.name}</span>

                    <div class="champion-traits-overlay">
                      {Array.isArray(cTraits) &&
                        cTraits.map((tName) => {
                          const tData = (allTraits || []).find(
                            (tr) => tr.name === tName || tr.apiName === tName
                          );
                          const tIcon = tData?.icon
                            ? getLocalTftImage(tData.icon, "traits", activeSet)
                            : "";
                          return (
                            tIcon && (
                              <div class="small-trait-hex">
                                <img src={tIcon} alt={tName} />
                              </div>
                            )
                          );
                        })}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>

      {data.video_url && (
        <>
          <div class="vertical-divider"></div>
          <div class="container-info-video">
            <Youtube src={data.video_url} client:load />
          </div>
        </>
      )}
    </div>

    {/* Niveles / Efectos de la sinergia */}
    {Array.isArray(currentEffects) && currentEffects.length > 0 && (
      <div class="trait-main-card">
        <div class="trait-effects">
          <h2>¿Qué hace el rasgo {displayName} en TFT Set {activeSet}?</h2>
          {currentEffects.map((effect, idx) => {
            const hexKey = styleMapping[effect.style] || "hex-bronze.webp";
            const customText =
              parsedCustomEffects[idx]?.description ||
              parsedCustomEffects[idx]?.desc ||
              (typeof parsedCustomEffects[idx] === "string"
                ? parsedCustomEffects[idx]
                : "");

            // Si no hay descripción por nivel escrita a mano, mostrar los valores numéricos relevantes de variables
            const fallbackVars =
              !customText && effect?.variables
                ? Object.entries(effect.variables)
                    .filter(([, val]) => val !== null && val !== undefined && val !== 0)
                    .slice(0, 4)
                    .map(([k, v]) => `${k}: ${Math.round(Number(v) * 100) / 100}`)
                    .join(" · ")
                : "";

            return (
              <div class="effect-row">
                <div
                  class={`effect-badge ${
                    hexKey === "hex-prismatic.webp" ? "prismatic-animated" : ""
                  }`}
                  style={
                    hexKey !== "hex-prismatic.webp" ? checkColor(hexKey) : {}
                  }
                >
                  {effect.minUnits}
                </div>
                <div class="effect-text">
                  {customText ||
                    fallbackVars ||
                    `Activa el nivel de ${effect.minUnits} unidades de ${displayName}.`}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {/* Composiciones agrupadas por set: Set más reciente abierto y anteriores desplegables */}
    <CompsPorSet
      entityName={displayName}
      entityType="sinergia"
      newestSetNumber={activeSet}
      compsBySet={compsBySet}
      client:load
    />

    {Array.isArray(parsedSecciones) &&
      parsedSecciones.length > 0 &&
      parsedSecciones.map((sec) => (
        <div class="section-block">
          <h2>{sec.titulo}</h2>
          <div
            class="section-content"
            set:html={procesarTexto(sec.descripcion)}
          />
        </div>
      ))}
  </div>
</LayoutMaxWidth>

<style>
  .header-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0 auto 30px auto;
    max-width: 900px;
    align-self: center;
    gap: 18px;
  }

  .two-columns {
    display: flex;
    flex-direction: row;
    gap: 20px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .container-info-left {
    width: 60%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .full-width {
    width: 100% !important;
  }

  .container-info-video {
    width: 40%;
    aspect-ratio: 16 / 9;
  }

  .vertical-divider {
    width: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    align-self: stretch;
  }

  .trait-main-card {
    background-color: #211c47;
    padding: 26px;
    border-radius: 14px;
    border: 1px solid rgba(123, 97, 255, 0.35);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    width: 100%;
  }

  .trait-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .trait-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .set-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: linear-gradient(135deg, #00ffc4, #63e6ff);
    color: #0b0920;
  }

  .patch-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
  }

  .trait-icon-bg {
    width: 54px;
    height: 54px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  .trait-header h1 {
    font-size: 1.55rem;
    color: #fff;
    margin: 0;
    font-weight: bold;
    line-height: 1.25;
  }

  .trait-desc {
    color: #e5e7eb;
    font-size: 1rem;
    line-height: 1.6;
  }

  .tip-jupeson-container {
    padding: 15px;
    background: rgba(123, 97, 255, 0.12);
    border: 1px solid rgba(123, 97, 255, 0.35);
    border-left: 4px solid #a78bfa;
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .tip-jupeson-title {
    color: #a78bfa;
    font-weight: bold;
    margin-right: 5px;
  }

  .sub-heading {
    font-size: 1.05rem;
    color: #cbd5e1;
    margin: 6px 0 14px 0;
  }

  .trait-effects {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .trait-effects h2 {
    margin: 0;
    font-size: 1.3rem;
    color: #ffffff;
  }

  .effect-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .effect-badge {
    width: 34px;
    height: 34px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: white;
    font-size: 1.05rem;
    border-radius: 6px;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.25);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  .effect-text {
    color: #e5e7eb;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @keyframes prismaticShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .prismatic-animated {
    background: linear-gradient(135deg, #00f2fe, #4facfe, #f093fb, #f5576c, #00f2fe);
    background-size: 300% 300%;
    animation: prismaticShift 4s ease infinite;
    color: white;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .list-champions {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: 18px;
    width: 100%;
    margin-top: 8px;
  }

  .champion-hex-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 76px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .champion-hex-container:hover {
    transform: translateY(-3px);
  }

  .champion-hex-shape {
    width: 70px;
    height: 80px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .champion-hex-shape img {
    width: 64px;
    height: 74px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    object-fit: cover;
  }

  .champion-name {
    margin-top: 6px;
    font-size: 0.8rem;
    color: #fff;
    font-weight: bold;
    text-shadow: 1px 1px 2px black;
    text-align: center;
  }

  .champion-traits-overlay {
    position: absolute;
    top: -10px;
    display: flex;
    justify-content: center;
    width: 100%;
    gap: 2px;
  }

  .small-trait-hex {
    width: 20px;
    height: 24px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background-color: #2c2754;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .small-trait-hex img {
    width: 13px;
    height: 13px;
    filter: invert(1);
  }

  .section-block {
    display: flex;
    flex-direction: column;
    background-color: #211c47;
    padding: 26px;
    border-radius: 12px;
    border: 1px solid rgba(123, 97, 255, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    width: 100%;
    box-sizing: border-box;
    gap: 16px;
  }

  .section-block h2 {
    margin: 0;
    color: #ffc832;
  }

  .section-content {
    display: flex;
    flex-direction: column;
    color: #e5e7eb;
    line-height: 1.6;
    gap: 14px;
  }

  .section-content :global(.imagen-dinamica) {
    text-align: center;
  }

  .section-content :global(.imagen-dinamica img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .section-content :global(.link-dinamico) {
    color: #00c9ff;
    text-decoration: none;
    font-weight: bold;
  }

  @media only screen and (max-width: 900px) {
    .trait-main-card,
    .section-block {
      padding: 18px;
    }

    .two-columns {
      flex-direction: column;
    }

    .container-info-left,
    .container-info-video {
      width: 100%;
    }

    .vertical-divider {
      width: 100%;
      height: 1px;
      margin: 6px 0;
    }

    .trait-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .trait-header h1 {
      font-size: 1.35rem;
    }

    .list-champions {
      justify-content: center;
      gap: 14px;
    }
  }
</style>

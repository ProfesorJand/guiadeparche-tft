---
import LayoutMaxWidth from "@layouts/LayoutMaxWidth.astro";
import CompsPorSet from "@components/TFT/meta/CompsPorSet.jsx";
import Youtube from "@components/youtube/Youtube.jsx";
import { setNumberPBE } from "@stores/dataTFT";
import { getLocalTftImage } from "@utils/images";
import { replaceVariables } from "@components/tooltips/functions.jsx";
import {
  compUsesItem,
  groupCompsBySet,
  normalizeItemApiName,
  safeJsonParse,
  slugifyTftEntity,
} from "@utils/tftEntitySlug.js";

const {
  data,
  entitySetNumber,
  matchingApiNames = [],
  allComps = [],
  setItems = [],
  itemSlugByApi = {},
  lastUpdate,
  version,
} = Astro.props;

const activeSet = String(entitySetNumber || data.tft_set || setNumberPBE);
const apiNamesToMatch = matchingApiNames.length > 0 ? matchingApiNames : [data.apiName];

// Filtrar todas las composiciones (de cualquier set) que usan este ítem
const relatedComps = (allComps || []).filter((comp) => compUsesItem(comp, apiNamesToMatch));
const compsBySet = groupCompsBySet(relatedComps, activeSet);

// Formatear la descripción oficial del ítem del set más reciente (ES con fallback automático a EN)
const rawDesc = data.desc_item || data.desc || data.desc_item_EN || "";
const parsedEffects = safeJsonParse(data.effects, data.effects || {}) || {};
const cleanFormattedDesc = replaceVariables(rawDesc, parsedEffects)
  ?.replace(/<\/?(tftitemrules|scaleLevel|TFTBonus|rules|i|b)[^>]*>/gi, (tag) => {
    const lower = tag.toLowerCase();
    if (lower === "<i>" || lower === "</i>" || lower === "<b>" || lower === "</b>") return tag;
    return "";
  })
  ?.replace(/(<br\s*\/?>\s*){3,}/gi, "<br /><br />")
  ?.trim();

// Extraer estadísticas legibles del objeto `effects` (útil como resumen rápido o si aún no hay texto descriptivo)
const STAT_LABELS = {
  ad: { label: "Daño de Ataque", isPercent: true },
  ad_notstatbar: { label: "Daño de Ataque", isPercent: true },
  ap: { label: "Poder de Habilidad", isPercent: false },
  ap_notstatbar: { label: "Poder de Habilidad", isPercent: false },
  as: { label: "Velocidad de Ataque", isPercent: false, suffix: "%" },
  attackspeed: { label: "Velocidad de Ataque", isPercent: false, suffix: "%" },
  health: { label: "Vida", isPercent: false },
  armor: { label: "Armadura", isPercent: false },
  magicresist: { label: "Resistencia Mágica", isPercent: false },
  mana: { label: "Maná", isPercent: false },
  manaregen: { label: "Regen. de Maná", isPercent: false },
  critchance: { label: "Prob. de Crítico", isPercent: false, suffix: "%" },
  statomnivamp_notstatbar: { label: "Omnivampirismo", isPercent: true },
  omnivamp: { label: "Omnivampirismo", isPercent: true },
  damageamp: { label: "Amplificación de Daño", isPercent: true },
  durability: { label: "Durabilidad", isPercent: true },
};

const statPills = Object.entries(parsedEffects)
  .map(([k, rawVal]) => {
    const numVal = Number(rawVal);
    if (!Number.isFinite(numVal) || numVal === 0) return null;
    const def = STAT_LABELS[k.toLowerCase()];
    if (!def) return null;
    const displayNum =
      def.isPercent && Math.abs(numVal) <= 2
        ? `${Math.round(numVal * 100)}%`
        : `${Math.round(numVal * 10) / 10}${def.suffix || ""}`;
    return { label: def.label, value: `+${displayNum}` };
  })
  .filter(Boolean);

// Resolver componentes de crafteo (si es un ítem crafteable de 2 piezas)
const rawComposition = safeJsonParse(data.composition, data.composition) || [];
const recipeComponents = Array.isArray(rawComposition)
  ? rawComposition
      .map((compApi) => {
        const normTarget = normalizeItemApiName(compApi);
        const found = (setItems || []).find(
          (i) => normalizeItemApiName(i.apiName) === normTarget
        );
        if (!found) return null;
        const slug =
          itemSlugByApi[(found.apiName || "").toLowerCase()] ||
          slugifyTftEntity(found.name);
        return {
          name: found.name,
          apiName: found.apiName,
          icon: getLocalTftImage(found.icon, "items", activeSet),
          slug,
        };
      })
      .filter(Boolean)
  : [];

const resolvedItemIcon = data.icon
  ? getLocalTftImage(data.icon, "items", activeSet)
  : "";

const isCraftable = recipeComponents.length === 2;

const title =
  data.titulo_seo ||
  (isCraftable
    ? `${data.name} TFT - Receta, Mejores Campeones y Compos (Set ${activeSet})`
    : `${data.name} TFT - Mejores Campeones y Compos (Set ${activeSet})`);
const plainDescSnippet = (cleanFormattedDesc || "")
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const description =
  data.descripcion_seo ||
  (plainDescSnippet
    ? `${data.name} en TFT Set ${activeSet}: ${plainDescSnippet.slice(0, 145)}... Descubre las mejores composiciones con ${data.name}.`
    : `Descubre el efecto, receta y las mejores composiciones para equipar el ítem ${data.name} en TFT Set ${activeSet}.`);

const currentVersion =
  activeSet === String(setNumberPBE)
    ? version?.MetaCompVersionPBE
    : version?.MetaCompVersion;

const parsedSecciones = safeJsonParse(data.secciones, []) || [];
---

<LayoutMaxWidth
  title={title}
  description={description}
  snippetImgUrl={resolvedItemIcon || data.icon}
>
  <div class="item-page-container">
    <section class="header-section">
      <div class={`two-columns ${!data.video_url ? "single-column" : ""}`}>
        <div id="container-info">
          <div class="item-hero-head">
            {resolvedItemIcon && (
              <div class="item-icon-frame">
                <img
                  src={resolvedItemIcon}
                  alt={`Ítem ${data.name} TFT Set ${activeSet}`}
                  class="item-main-icon"
                />
              </div>
            )}
            <div class="item-title-block">
              <div class="badges-row">
                <span class="set-badge">Set {activeSet}</span>
                {currentVersion && (
                  <span class="patch-badge">Parche {currentVersion}</span>
                )}
              </div>
              <h1>
                {isCraftable
                  ? `${data.name} TFT - Receta, Mejores Campeones y Compos`
                  : `${data.name} TFT - Mejores Campeones y Compos`}
              </h1>
            </div>
          </div>

          <div class="item-intro-paragraphs">
            {isCraftable && (
              <p class="item-intro-p">
                <span class="colored-text">{data.name}</span> se arma combinando{" "}
                <span class="colored-text">{recipeComponents[0].name}</span> y{" "}
                <span class="colored-text">{recipeComponents[1].name}</span>.
              </p>
            )}
            <p class="item-intro-p">
              A continuación la información del objeto y sus mejores composiciones.
            </p>
          </div>

          {(cleanFormattedDesc || statPills.length > 0) && (
            <div class="item-desc-card">
              <h2 class="desc-label">Información del Objeto (Set {activeSet})</h2>
              {statPills.length > 0 && (
                <div class="stat-pills-row">
                  {statPills.map((s) => (
                    <span class="stat-pill">
                      <strong>{s.value}</strong> {s.label}
                    </span>
                  ))}
                </div>
              )}
              {cleanFormattedDesc && (
                <div class="item-desc-html" set:html={cleanFormattedDesc} />
              )}
            </div>
          )}

          {recipeComponents.length === 2 && (
            <div class="recipe-container">
              <span class="recipe-label">Receta de crafteo:</span>
              <div class="recipe-items">
                <a
                  href={`/tft/meta-comps-tier-list-teamfight-tactics/${recipeComponents[0].slug}`}
                  class="recipe-chip"
                >
                  <img
                    src={recipeComponents[0].icon}
                    alt={recipeComponents[0].name}
                  />
                  <span>{recipeComponents[0].name}</span>
                </a>
                <span class="recipe-plus">+</span>
                <a
                  href={`/tft/meta-comps-tier-list-teamfight-tactics/${recipeComponents[1].slug}`}
                  class="recipe-chip"
                >
                  <img
                    src={recipeComponents[1].icon}
                    alt={recipeComponents[1].name}
                  />
                  <span>{recipeComponents[1].name}</span>
                </a>
              </div>
            </div>
          )}

          {data.tip_jupeson && (
            <div class="tip-jupeson-container">
              <span class="tip-jupeson-title">💡 Tip Jupeson:</span>
              <span class="tip-jupeson-text">{data.tip_jupeson}</span>
            </div>
          )}

          <p class="update-meta">
            Última actualización: {lastUpdate}
            {currentVersion ? ` · Parche ${currentVersion}` : ""}
          </p>
        </div>

        {data.video_url && (
          <div class="container-video">
            <Youtube src={data.video_url} client:load />
          </div>
        )}
      </div>
    </section>

    {/* Composiciones: Set más reciente abierto y sets anteriores desplegables */}
    <CompsPorSet
      entityName={data.name}
      entityType="item"
      newestSetNumber={activeSet}
      compsBySet={compsBySet}
      client:load
    />

    {Array.isArray(parsedSecciones) && parsedSecciones.length > 0 && (
      <div class="dynamic-sections">
        {parsedSecciones.map((sec) => (
          <div class="section-block">
            <h2>{sec.titulo}</h2>
            <div class="section-content" set:html={sec.descripcion} />
          </div>
        ))}
      </div>
    )}
  </div>
</LayoutMaxWidth>

<style>
  .item-page-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto 40px auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .header-section {
    width: 100%;
    background: linear-gradient(135deg, rgba(24, 19, 58, 0.92), rgba(16, 13, 42, 0.78));
    padding: 26px;
    border-radius: 16px;
    border: 1px solid rgba(123, 97, 255, 0.45);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.42);
    box-sizing: border-box;
  }

  .two-columns {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .single-column #container-info {
    width: 100%;
  }

  #container-info {
    width: 60%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .container-video {
    width: 40%;
    aspect-ratio: 16 / 9;
  }

  .item-hero-head {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .item-icon-frame {
    width: 78px;
    height: 78px;
    flex-shrink: 0;
    border-radius: 14px;
    padding: 4px;
    background: linear-gradient(135deg, #7b61ff, var(--color-text-highlight));
    box-shadow: 0 6px 18px rgba(123, 97, 255, 0.35);
  }

  .item-main-icon {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
    display: block;
    background: #121034;
  }

  .item-title-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .set-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-text-highlight), #63e6ff);
    color: #0b0920;
  }

  .patch-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
  }

  .item-title-block h1 {
    margin: 0;
    font-size: 1.95rem;
    line-height: 1.2;
    color: #ffffff;
  }

  .colored-text {
    color: #a78bfa;
    font-weight: 600;
  }

  .item-intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .item-intro-p {
    margin: 0;
    color: #e5e7eb;
    font-size: 1rem;
    line-height: 1.55;
  }

  .item-desc-card {
    background: rgba(12, 10, 32, 0.65);
    border: 1px solid rgba(167, 139, 250, 0.28);
    border-radius: 12px;
    padding: 16px 18px;
  }

  .desc-label {
    margin: 0 0 8px 0;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-highlight);
  }

  .item-desc-html {
    color: #e5e7eb;
    font-size: 1rem;
    line-height: 1.65;
  }

  .stat-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(123, 97, 255, 0.16);
    border: 1px solid rgba(167, 139, 250, 0.35);
    color: #e2e8f0;
    font-size: 0.85rem;
  }

  .stat-pill strong {
    color: var(--color-text-highlight);
  }

  .item-desc-html :global(img) {
    width: 16px;
    height: 16px;
    vertical-align: middle;
    margin: 0 2px;
  }

  .recipe-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .recipe-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .recipe-items {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .recipe-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(123, 97, 255, 0.18);
    border: 1px solid rgba(123, 97, 255, 0.4);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .recipe-chip:hover {
    background: rgba(123, 97, 255, 0.35);
    transform: translateY(-1px);
  }

  .recipe-chip img {
    width: 24px;
    height: 24px;
    border-radius: 5px;
  }

  .recipe-plus {
    font-weight: 800;
    color: #f5e020;
    font-size: 1.1rem;
  }

  .tip-jupeson-container {
    padding: 15px;
    background: rgba(123, 97, 255, 0.12);
    border: 1px solid rgba(123, 97, 255, 0.35);
    border-left: 4px solid #a78bfa;
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .tip-jupeson-title {
    color: #a78bfa;
    font-weight: bold;
    margin-right: 6px;
  }

  .update-meta {
    margin: 0;
    font-size: 0.84rem;
    color: #94a3b8;
  }

  .dynamic-sections {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-block {
    background: rgba(28, 22, 54, 0.72);
    padding: 20px;
    border-radius: 12px;
    border-left: 4px solid #7b61ff;
  }

  .section-block h2 {
    color: #ffc832;
    margin-top: 0;
  }

  .section-content {
    color: #e5e7eb;
    line-height: 1.6;
  }

  @media only screen and (max-width: 900px) {
    .header-section {
      padding: 18px;
    }

    .two-columns {
      flex-direction: column;
      gap: 1.25rem;
    }

    #container-info,
    .container-video {
      width: 100%;
    }

    .item-hero-head {
      align-items: flex-start;
      gap: 14px;
    }

    .item-icon-frame {
      width: 64px;
      height: 64px;
    }

    .item-title-block h1 {
      font-size: 1.45rem;
    }

    .recipe-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
